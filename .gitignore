/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
.playwright-mcp

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.storyblok/logs
.storyblok/reports

