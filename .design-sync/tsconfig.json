{
	// Read by the /design-sync converter only. Mirrors jsconfig.json's @/ alias
	// and swaps the Storyblok SDK for the mock Storybook uses
	// (.storybook/main.js), so the bundle renders what the reference renders.
	"compilerOptions": {
		"baseUrl": "..",
		"paths": {
			"@/*": ["src/*"],
			"@storyblok/react/rsc": [".storybook/mocks/storyblok.jsx"]
		}
	}
}
