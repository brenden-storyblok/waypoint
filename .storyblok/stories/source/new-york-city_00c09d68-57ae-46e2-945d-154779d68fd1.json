  "content": {
    "_uid": "02428e0f-9f52-49dc-9bc6-7405ab56e633",
    "name": "New York City",
    "usps": [
      {
        "_uid": "14b185d1-c825-4c2d-8971-7907d34ee709",
        "text": "The 843-acre park runs 51 blocks from 59th Street to 110th Street.",
        "title": "Central Park in the middle",
        "component": "usp_item"
      },
      {
        "_uid": "c34aaf26-bcac-4db9-a96e-1955f8ccb25e",
        "text": "The 1883 bridge has a raised walkway over the East River with views of Lower Manhattan.",
        "title": "Walk the Brooklyn Bridge",
        "component": "usp_item"
      },
      {
        "_uid": "4e74b32f-6101-4ac5-bdaf-caf9a40a596c",
        "text": "The 41 Broadway theatres around Times Square stage shows eight times a week.",
        "title": "Broadway after dark",
        "component": "usp_item"
      },
      {
        "_uid": "380f9f5d-687d-4f6c-a09f-7cd411a96f83",
        "text": "Eat dumplings in Flushing, arepas in Jackson Heights and pastrami at Katz's, open since 1888.",
        "title": "A food map of the world",
        "component": "usp_item"
      }
    ],
    "region": "New York",
    "country": "united-states",
