      },
      {
        "_uid": "0459d144-e3cd-4e5a-9d53-d33d0dc578d5",
        "headline": "Why Marrakech",
        "component": "destination_usps"
      },
      {
        "_uid": "b3e77cc5-c15d-4844-9fb3-9286d47266aa",
        "headline": "About Marrakech",
        "component": "destination_bio"
      },
      {
        "_uid": "d07f00da-14a0-4037-8ed0-b8d331a5cb41",
        "headline": "Marrakech in pictures",
        "component": "destination_gallery"
      },
      {
        "_uid": "8c20d410-fa0c-49b0-aeec-867251bef606",
        "text": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "The medina is a walking city, and most of its lanes are too narrow for cars. Beige petit taxis cover trips beyond the walls; ask the driver to run the meter or agree the fare before you get in.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Menara Airport is about 6 km from Jemaa el-Fna, around 15 minutes by taxi.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Trains from Marrakech to Casablanca take under 3 hours.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Imlil, the trailhead for Toubkal, is about 90 minutes by road.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "headline": "Getting around",
        "component": "text_block"
      }
    ],
