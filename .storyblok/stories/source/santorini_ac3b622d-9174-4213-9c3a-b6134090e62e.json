  "uuid": "ac3b622d-9174-4213-9c3a-b6134090e62e",
  "is_folder": false,
  "content": {
    "_uid": "7a2d9c10-5e0b-4c11-8a31-1b0f6d2e4c01",
    "name": "Santorini",
    "usps": [
      {
        "_uid": "7a2d9c10-5e0b-4c11-8a31-1b0f6d2e4c11",
        "text": "The caldera path links the two towns along the cliff edge. Plan on about three hours one way.",
        "title": "Fira to Oia on foot",
        "component": "usp_item"
      },
      {
        "_uid": "7a2d9c10-5e0b-4c11-8a31-1b0f6d2e4c12",
        "text": "Red Beach, Perissa and Kamari have red, black and dark sand shaped by the volcano.",
        "title": "Volcanic beaches",
        "component": "usp_item"
      },
      {
        "_uid": "7a2d9c10-5e0b-4c11-8a31-1b0f6d2e4c13",
        "text": "Vines grow in low baskets on volcanic soil. Several wineries pour tastings with caldera views.",
        "title": "Assyrtiko wine",
        "component": "usp_item"
      },
      {
        "_uid": "7a2d9c10-5e0b-4c11-8a31-1b0f6d2e4c14",
        "text": "Volcanic ash preserved a Bronze Age settlement. Its multi-storey houses still stand under a covered roof.",
        "title": "Akrotiri, the buried town",
        "component": "usp_item"
      }
    ],
    "region": "Cyclades",
    "country": "greece",
