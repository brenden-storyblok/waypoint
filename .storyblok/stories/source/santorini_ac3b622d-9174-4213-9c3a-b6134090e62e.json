    "summary": "A crescent of white villages on the rim of a flooded volcano. The cliffs drop straight into the caldera.",
    "component": "destination",
    "attributes": [
      "beach",
      "island"
    ],
    "hero_image": {
      "id": 230846316339836,
      "alt": "Blue-domed church in Oia above the caldera, with the cliffs of the island across the water",
      "name": "",
      "focus": "",
      "title": "",
      "filename": "https://a.storyblok.com/f/295888311565739/1b58fd1d72/santorini-oia-harbor.jpg",
