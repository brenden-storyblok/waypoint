    "description": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Santorini is the curved remnant of a volcano in the southern Cyclades. A huge eruption in the Bronze Age collapsed the centre and left a caldera, now filled by the sea.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Fira, Imerovigli and Oia line the cliff edge. Their white houses and blue church domes face the caldera. On the outer coast, the beaches are black, red or white volcanic sand and pebbles.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "May, June, September and October bring warm sea and fewer people. Oia is busiest at sunset, so book dinner ahead.",
              "type": "text"
            }
          ]
        }
      ]
    },
