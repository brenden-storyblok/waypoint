  "content": {
    "_uid": "b2e5d8f3-6c40-4d2b-8f71-2a3c8b9d1e22",
    "answer": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "No. Waypoint is an editorial guide. We do not sell trips.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "question": "Can I book trips through Waypoint?",
    "component": "faq_item",
    "answer__i18n__de": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Nein. Waypoint ist ein redaktioneller Reiseführer. Wir verkaufen keine Reisen.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "answer__i18n__es": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "No. Waypoint es una guía editorial. No vendemos viajes.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "answer__i18n__fr": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Non. Waypoint est un guide éditorial. Nous ne vendons pas de voyages.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "question__i18n__de": "Kann ich über Waypoint Reisen buchen?",
