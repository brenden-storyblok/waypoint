  "content": {
    "_uid": "e332c5b6-16e3-4e36-ab40-68c49df12ce6",
    "name": "Bali",
    "usps": [
      {
        "_uid": "277268d8-81e0-4cfc-a8bf-d6f86e43add7",
        "text": "Tanah Lot stands on a rock in the surf, and Ulun Danu Bratan's shrines sit on the edge of a crater lake.",
        "title": "Temples on the water",
        "component": "usp_item"
      },
      {
        "_uid": "2792194e-fde8-4981-9f4d-e7d61a931e93",
        "text": "The water-sharing system behind Jatiluwih and Tegallalang dates back more than a thousand years.",
        "title": "Terraces shaped by subak",
        "component": "usp_item"
      },
      {
        "_uid": "beb4c78a-1212-4263-b829-14b083ac002e",
        "text": "Legong and Kecak performances run most evenings in Ubud's palace and temple courtyards.",
        "title": "Ubud's dance stages",
        "component": "usp_item"
      },
      {
        "_uid": "c09d3ffc-d4b8-4e3a-8766-d25583795163",
        "text": "Fast boats from Sanur reach the cliffs and coves of Nusa Penida in under an hour.",
        "title": "Nusa Penida by boat",
        "component": "usp_item"
      }
    ],
    "region": "Lesser Sunda Islands",
    "country": "indonesia",
