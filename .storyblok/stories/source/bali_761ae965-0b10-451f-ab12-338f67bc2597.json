    ],
    "hero_image": {
      "id": 230951149366521,
      "alt": "Green rice terraces step down toward palm trees with a cloud-capped volcano behind in morning haze.",
      "name": "",
      "focus": "",
      "title": "",
      "source": "",
      "filename": "https://a.storyblok.com/f/295888311565739/4fb12dd90d/bali-rice-dawn.jpg",
