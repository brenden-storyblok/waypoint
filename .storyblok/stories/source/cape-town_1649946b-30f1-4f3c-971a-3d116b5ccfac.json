  "content": {
    "_uid": "6e17cfba-163b-4bf8-ae05-63af6c4b1892",
    "name": "Cape Town",
    "usps": [
      {
        "_uid": "db54f623-ea63-4073-8674-fedef277ff91",
        "text": "Rotating cable cars climb from Tafelberg Road to the summit in about five minutes.",
        "title": "Table Mountain cableway",
        "component": "usp_item"
      },
      {
        "_uid": "9105997c-e971-437a-89cc-ef81914d697f",
        "text": "A colony of endangered African penguins nests on the sand at Simon's Town on False Bay.",
        "title": "Penguins at Boulders Beach",
        "component": "usp_item"
      },
      {
        "_uid": "15feb408-82ea-41e7-a4e9-075809bb7a90",
        "text": "Ferries from the V&A Waterfront run to the prison where Nelson Mandela was held for 18 years.",
        "title": "Robben Island",
        "component": "usp_item"
      },
      {
        "_uid": "80a5986d-a13f-451c-92ca-7c4649eeab66",
        "text": "Stellenbosch and Franschhoek, both under 90 minutes by car, have grown wine since the 17th century.",
        "title": "Winelands next door",
        "component": "usp_item"
      }
    ],
    "region": "Western Cape",
    "country": "south-africa",
