  "id": 230949371451149,
  "uuid": "e513a009-daec-4b48-aea7-5999e6801c62",
  "is_folder": false,
  "content": {
    "_uid": "997a34bc-e59a-41cc-9969-d5b38658dd2a",
    "body": [
      {
        "_uid": "f08649ab-85cf-4702-83ce-be2037dca614",
        "component": "destination_hero"
      },
      {
        "_uid": "463dd957-ec88-43c4-bf63-0b3c2dbe28b7",
        "headline": "Why Scottish Highlands",
        "component": "destination_usps",
        "headline__i18n__de": "Warum das Schottische Hochland",
        "headline__i18n__es": "Por qué las Tierras Altas de Escocia",
        "headline__i18n__fr": "Pourquoi les Highlands écossaises"
      },
      {
        "_uid": "1bac19e4-303d-4bd1-9455-8e5494fbdbbf",
        "headline": "About Scottish Highlands",
        "component": "destination_bio",
        "headline__i18n__de": "Über das Schottische Hochland",
        "headline__i18n__es": "Sobre las Tierras Altas de Escocia",
        "headline__i18n__fr": "À propos des Highlands écossaises"
      },
      {
        "_uid": "094f8d8a-357d-42e1-befb-65099cdd45f7",
        "headline": "Scottish Highlands in pictures",
        "component": "destination_gallery",
        "headline__i18n__de": "Das Schottische Hochland in Bildern",
        "headline__i18n__es": "Las Tierras Altas de Escocia en imágenes",
        "headline__i18n__fr": "Les Highlands écossaises en images"
      },
      {
        "_uid": "d14c7888-b09b-44f1-af39-2acc70629ce9",
        "text": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "A car gives the most freedom, but many roads in the north and west are single-track with passing places. ScotRail runs the West Highland Line and the Highland Main Line, and Citylink coaches link the towns.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Edinburgh to Inverness by train takes about 3 hours 30 minutes.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Glasgow Queen Street to Fort William on the West Highland Line takes just under 4 hours.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "The drive from Inverness to the Skye Bridge at Kyle of Lochalsh is about 130 kilometres.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "headline": "Getting around",
        "component": "text_block",
        "text__i18n__de": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Mit einem Auto bist du am freiesten, doch viele Straßen im Norden und Westen sind einspurig mit Ausweichstellen. ScotRail betreibt die West Highland Line und die Highland Main Line, und Citylink-Busse verbinden die Orte.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Von Edinburgh nach Inverness dauert die Zugfahrt etwa 3 Stunden 30 Minuten.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Von Glasgow Queen Street nach Fort William auf der West Highland Line braucht man knapp 4 Stunden.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Die Fahrt von Inverness zur Skye Bridge bei Kyle of Lochalsh ist etwa 130 Kilometer lang.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "text__i18n__es": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Un coche da la mayor libertad, pero muchas carreteras del norte y el oeste son de un solo carril con zonas de cruce. ScotRail opera la West Highland Line y la Highland Main Line, y los autocares de Citylink conectan las localidades.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "De Edimburgo a Inverness en tren se tardan unas 3 horas y 30 minutos.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "De Glasgow Queen Street a Fort William por la West Highland Line se tarda poco menos de 4 horas.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "El trayecto en coche de Inverness al puente de Skye en Kyle of Lochalsh es de unos 130 kilómetros.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "text__i18n__fr": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "La voiture offre le plus de liberté, mais de nombreuses routes du nord et de l'ouest sont à voie unique avec des zones de croisement. ScotRail exploite la West Highland Line et la Highland Main Line, et les autocars Citylink relient les villes.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "D'Édimbourg à Inverness en train, comptez environ 3 heures 30.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "De Glasgow Queen Street à Fort William par la West Highland Line, il faut un peu moins de 4 heures.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Le trajet en voiture d'Inverness au pont de Skye à Kyle of Lochalsh représente environ 130 kilomètres.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "headline__i18n__de": "Unterwegs",
        "headline__i18n__es": "Cómo moverse",
        "headline__i18n__fr": "Se déplacer"
      }
    ],
