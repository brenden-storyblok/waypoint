      },
      {
        "_uid": "463dd957-ec88-43c4-bf63-0b3c2dbe28b7",
        "headline": "Why Scottish Highlands",
        "component": "destination_usps"
      },
      {
        "_uid": "1bac19e4-303d-4bd1-9455-8e5494fbdbbf",
        "headline": "About Scottish Highlands",
        "component": "destination_bio"
      },
      {
        "_uid": "094f8d8a-357d-42e1-befb-65099cdd45f7",
        "headline": "Scottish Highlands in pictures",
        "component": "destination_gallery"
      },
      {
        "_uid": "d14c7888-b09b-44f1-af39-2acc70629ce9",
        "text": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "A car gives the most freedom, but many roads in the north and west are single-track with passing places. ScotRail runs the West Highland Line and the Highland Main Line, and Citylink coaches link the towns.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Edinburgh to Inverness by train takes about 3 hours 30 minutes.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Glasgow Queen Street to Fort William on the West Highland Line takes just under 4 hours.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "The drive from Inverness to the Skye Bridge at Kyle of Lochalsh is about 130 kilometres.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "headline": "Getting around",
        "component": "text_block"
      }
    ],
    "component": "destination_page",
    "destination": "7c70b6ff-0470-4954-aaac-5853790c6cd9"
  },
