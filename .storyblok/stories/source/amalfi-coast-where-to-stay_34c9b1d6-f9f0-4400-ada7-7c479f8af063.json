  "is_folder": false,
  "content": {
    "_uid": "a18bb14f-c025-4d7a-976a-d5cbf179c4ba",
    "answer": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Amalfi is the most central base for buses and ferries. Positano is the most photographed town, but it is steep and full of stairs.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Ravello sits high above the coast and is quiet in the evening.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "question": "Where should I stay?",
    "component": "faq_item"
  },
