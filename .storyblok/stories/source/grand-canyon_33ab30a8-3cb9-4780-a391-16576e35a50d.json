    "_uid": "9255941f-d820-4fff-90d9-7c38aae349f6",
    "name": "Grand Canyon",
    "usps": [
      {
        "_uid": "d6e9d28b-a4e1-4df7-a71f-690f44f0e70f",
        "text": "This Hermit Road viewpoint looks west over a long stretch of the Colorado River.",
        "title": "Sunset at Hopi Point",
        "component": "usp_item"
      },
      {
        "_uid": "78adf23b-053d-4879-8038-2da71bf9ec56",
        "text": "The Bright Angel Trail drops about 1,300 m over 16 km to Phantom Ranch.",
        "title": "Rim to river on foot",
        "component": "usp_item"
      },
      {
        "_uid": "d7fb5c30-049e-4839-942f-766122b7135c",
        "text": "The falls sit on Havasupai land, a 16 km hike from the trailhead with a permit.",
        "title": "Turquoise water at Havasu Falls",
        "component": "usp_item"
      },
      {
        "_uid": "ca90f174-b1ea-4acc-ad67-b70cba64783b",
        "text": "The Rim Trail links viewpoints from the South Kaibab Trailhead to Hermits Rest.",
        "title": "21 km of rim walking",
        "component": "usp_item"
      }
    ],
