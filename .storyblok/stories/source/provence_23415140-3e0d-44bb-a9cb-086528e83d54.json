  "uuid": "23415140-3e0d-44bb-a9cb-086528e83d54",
  "is_folder": false,
  "content": {
    "_uid": "c152f4b0-ff83-4a02-b18b-d15892a02070",
    "body": [
      {
        "_uid": "9f1c2d3e-4a5b-4c6d-8e7f-0a1b2c3d4e01",
        "component": "destination_hero"
      },
      {
        "_uid": "9f1c2d3e-4a5b-4c6d-8e7f-0a1b2c3d4e02",
        "headline": "Why Provence",
        "component": "destination_usps",
        "headline__i18n__de": "Warum die Provence",
        "headline__i18n__es": "Por qué la Provenza",
        "headline__i18n__fr": "Pourquoi la Provence"
      },
      {
        "_uid": "9f1c2d3e-4a5b-4c6d-8e7f-0a1b2c3d4e03",
        "headline": "About Provence",
        "component": "destination_bio",
        "headline__i18n__de": "Über die Provence",
        "headline__i18n__es": "Sobre la Provenza",
        "headline__i18n__fr": "À propos de la Provence"
      },
      {
        "_uid": "9f1c2d3e-4a5b-4c6d-8e7f-0a1b2c3d4e04",
        "headline": "Provence in pictures",
        "component": "destination_gallery",
        "headline__i18n__de": "Die Provence in Bildern",
        "headline__i18n__es": "La Provenza en imágenes",
        "headline__i18n__fr": "La Provence en images"
      },
      {
        "_uid": "9f1c2d3e-4a5b-4c6d-8e7f-0a1b2c3d4e05",
        "text": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "A car is the practical choice for villages, abbeys and lavender fields. Public transport covers the main towns.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "TGV trains stop at Avignon and Aix-en-Provence.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "ZOU! regional buses link the larger towns.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Rent a car at the station and drive the Luberon villages.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "headline": "Getting around",
        "component": "text_block",
        "text__i18n__de": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Für Dörfer, Abteien und Lavendelfelder ist ein Auto die praktische Wahl. Der öffentliche Nahverkehr deckt die größeren Orte ab.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "TGV-Züge halten in Avignon und Aix-en-Provence.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Die Regionalbusse von ZOU! verbinden die größeren Städte.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Miete am Bahnhof ein Auto und fahre durch die Dörfer des Luberon.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "text__i18n__es": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "El coche es la opción práctica para pueblos, abadías y campos de lavanda. El transporte público cubre las ciudades principales.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Los trenes TGV paran en Aviñón y Aix-en-Provence.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Los autobuses regionales ZOU! conectan las ciudades más grandes.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Alquila un coche en la estación y recorre los pueblos del Luberon.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "text__i18n__fr": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "La voiture est le choix pratique pour les villages, les abbayes et les champs de lavande. Les transports en commun desservent les principales villes.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Les TGV s'arrêtent à Avignon et à Aix-en-Provence.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Les bus régionaux ZOU! relient les villes les plus importantes.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Louez une voiture à la gare et parcourez les villages du Luberon.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "headline__i18n__de": "Unterwegs",
        "headline__i18n__es": "Cómo moverse",
        "headline__i18n__fr": "Se déplacer"
      },
