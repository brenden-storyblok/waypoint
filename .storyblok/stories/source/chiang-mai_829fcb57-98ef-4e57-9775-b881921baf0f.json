        "component": "destination_hero"
      },
      {
        "_uid": "87b3a96f-d416-4d1d-895f-48fe27b53aff",
        "headline": "Why Chiang Mai",
        "component": "destination_usps"
      },
      {
        "_uid": "f4a8bc78-7bc3-4a43-b6e3-faf137a13b9b",
        "headline": "About Chiang Mai",
        "component": "destination_bio"
      },
      {
        "_uid": "23e678c7-26f9-465b-b83a-51cab35b590c",
        "headline": "Chiang Mai in pictures",
        "component": "destination_gallery"
      },
      {
        "_uid": "cbb69c08-cef9-473a-9ece-aaf15605cd40",
        "text": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Red shared pickup trucks called songthaew run fixed and flexible routes around the city. Agree the fare before you climb in, or book a car through the Grab app. The old city is small enough to cross on foot.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Chiang Mai Airport is about 15 minutes by car from the old city.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "A songthaew up the mountain road to Doi Suthep takes about 40 minutes.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Flights from Bangkok take about 1 hour 15 minutes, and the overnight train takes 11 to 13 hours.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "headline": "Getting around",
        "component": "text_block"
      }
    ],
