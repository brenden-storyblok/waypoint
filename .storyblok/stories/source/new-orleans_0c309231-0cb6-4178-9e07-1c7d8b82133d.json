  "content": {
    "_uid": "987af73c-759c-4fbd-8e61-237a7123aa05",
    "name": "New Orleans",
    "usps": [
      {
        "_uid": "9b7ef655-fc46-46be-b2cb-a90155deeb94",
        "text": "Clubs like the Spotted Cat Music Club book live bands every night of the week.",
        "title": "Live music on Frenchmen Street",
        "component": "usp_item"
      },
      {
        "_uid": "9384f3de-f1fd-4ee5-8b25-8bba98ef0549",
        "text": "The French Market coffee stand has served beignets and chicory café au lait since 1862.",
        "title": "Beignets at Café du Monde",
        "component": "usp_item"
      },
      {
        "_uid": "c34c9b79-4c2e-4834-b949-22d47785f1d6",
        "text": "The St. Charles line, running since 1835, is the oldest continuously operating street railway in the world.",
        "title": "Streetcars under the oaks",
        "component": "usp_item"
      },
      {
        "_uid": "5552de77-d568-4f7e-8abd-ed382fc467a5",
        "text": "St. Louis Cathedral, rebuilt in 1850, faces the square where engineers laid out the city in 1721.",
        "title": "Jackson Square",
        "component": "usp_item"
      }
    ],
