  "uuid": "7901bdb6-3c8b-46d6-ab0f-2b76535f4173",
  "is_folder": false,
  "content": {
    "_uid": "6a1c0b52-3f1e-4d8e-9a77-1b2c3d4e6001",
    "name": "Seville",
    "usps": [
      {
        "_uid": "6a1c0b52-3f1e-4d8e-9a77-1b2c3d4e6101",
        "text": "The royal palace mixes Moorish and Christian styles, with courtyards, tilework and gardens. Spain's royal family still uses part of it.",
        "title": "The Real Alcázar",
        "component": "usp_item"
      },
      {
        "_uid": "6a1c0b52-3f1e-4d8e-9a77-1b2c3d4e6102",
        "text": "Bars across the river from the centre serve small plates at the counter. Order a few at a time.",
        "title": "Tapas in Triana",
        "component": "usp_item"
      },
      {
        "_uid": "6a1c0b52-3f1e-4d8e-9a77-1b2c3d4e6103",
        "text": "Small tablaos in the old town stage guitar, song and dance in rooms that seat a few dozen.",
        "title": "Flamenco up close",
        "component": "usp_item"
      },
      {
        "_uid": "6a1c0b52-3f1e-4d8e-9a77-1b2c3d4e6104",
        "text": "A brick semicircle with a canal, rowing boats and tiled benches for each Spanish province.",
        "title": "Plaza de España",
        "component": "usp_item"
      }
    ],
    "region": "Andalusia",
    "country": "spain",
