    "body": [
      {
        "_uid": "6a1c0b52-3f1e-4d8e-9a77-1b2c3d4e7101",
        "component": "destination_hero"
      },
      {
        "_uid": "6a1c0b52-3f1e-4d8e-9a77-1b2c3d4e7102",
        "headline": "Why Seville",
        "component": "destination_usps"
      },
      {
        "_uid": "6a1c0b52-3f1e-4d8e-9a77-1b2c3d4e7103",
        "headline": "About Seville",
        "component": "destination_bio"
      },
      {
        "_uid": "6a1c0b52-3f1e-4d8e-9a77-1b2c3d4e7104",
        "headline": "Seville in pictures",
        "component": "destination_gallery"
      },
      {
        "_uid": "6a1c0b52-3f1e-4d8e-9a77-1b2c3d4e7105",
        "text": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Most of the old town is best covered on foot. Tussam buses, one metro line and a short tram line handle longer trips.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Airport bus EA runs between the airport and the city centre.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Sevici bike-share stations and dedicated bike lanes cover the flat city.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "The metro has a single line, Line 1, and the tram is a short line through the centre.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "headline": "Getting around",
        "component": "text_block"
      },
