  "id": 230847611394786,
  "uuid": "25650ee1-7417-4747-9192-17072ad33c4f",
  "is_folder": false,
  "content": {
    "_uid": "6a1c0b52-3f1e-4d8e-9a77-1b2c3d4e7001",
    "body": [
      {
        "_uid": "6a1c0b52-3f1e-4d8e-9a77-1b2c3d4e7101",
        "component": "destination_hero"
      },
      {
        "_uid": "6a1c0b52-3f1e-4d8e-9a77-1b2c3d4e7102",
        "headline": "Why Seville",
        "component": "destination_usps",
        "headline__i18n__de": "Warum Sevilla",
        "headline__i18n__es": "Por qué Sevilla",
        "headline__i18n__fr": "Pourquoi Séville"
      },
      {
        "_uid": "6a1c0b52-3f1e-4d8e-9a77-1b2c3d4e7103",
        "headline": "About Seville",
        "component": "destination_bio",
        "headline__i18n__de": "Über Sevilla",
        "headline__i18n__es": "Sobre Sevilla",
        "headline__i18n__fr": "À propos de Séville"
      },
      {
        "_uid": "6a1c0b52-3f1e-4d8e-9a77-1b2c3d4e7104",
        "headline": "Seville in pictures",
        "component": "destination_gallery",
        "headline__i18n__de": "Sevilla in Bildern",
        "headline__i18n__es": "Sevilla en imágenes",
        "headline__i18n__fr": "Séville en images"
      },
      {
        "_uid": "6a1c0b52-3f1e-4d8e-9a77-1b2c3d4e7105",
        "text": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Most of the old town is best covered on foot. Tussam buses, one metro line and a short tram line handle longer trips.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Airport bus EA runs between the airport and the city centre.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Sevici bike-share stations and dedicated bike lanes cover the flat city.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "The metro has a single line, Line 1, and the tram is a short line through the centre.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "headline": "Getting around",
        "component": "text_block",
        "text__i18n__de": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Die Altstadt erkundet man am besten zu Fuß. Für längere Strecken gibt es die Tussam-Busse, eine Metrolinie und eine kurze Straßenbahnlinie.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Der Flughafenbus EA verkehrt zwischen dem Flughafen und dem Stadtzentrum.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Sevici-Leihradstationen und eigene Radwege erschließen die flache Stadt.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Die Metro hat nur eine Linie, die Linie 1, und die Straßenbahn ist eine kurze Linie durch das Zentrum.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "text__i18n__es": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "El casco antiguo se recorre mejor a pie. Los autobuses de Tussam, una línea de metro y una corta línea de tranvía cubren los trayectos más largos.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "El autobús del aeropuerto EA circula entre el aeropuerto y el centro de la ciudad.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Las estaciones de bicicletas compartidas Sevici y los carriles bici cubren esta ciudad llana.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "El metro tiene una sola línea, la Línea 1, y el tranvía es una línea corta que atraviesa el centro.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "text__i18n__fr": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "La vieille ville se parcourt surtout à pied. Les bus Tussam, une ligne de métro et une courte ligne de tramway assurent les trajets plus longs.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Le bus aéroport EA relie l'aéroport et le centre-ville.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Les stations de vélos en libre-service Sevici et les pistes cyclables desservent cette ville plate.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Le métro ne compte qu'une ligne, la ligne 1, et le tramway est une courte ligne qui traverse le centre.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "headline__i18n__de": "Unterwegs",
        "headline__i18n__es": "Cómo moverse",
        "headline__i18n__fr": "Se déplacer"
      },
