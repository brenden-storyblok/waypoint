{
  "name": "When is the best time to visit the Bavarian Alps?",
  "parent_id": 230624347930176,
  "group_id": "55e98ceb-17df-4e02-92e0-e1542f2aa04f",
  "alternates": [],
  "created_at": "2026-10-15T07:18:03.746Z",
