  "updated_at": "2026-10-15T08:00:37.101Z",
  "published_at": "2026-10-15T08:00:36.161Z",
  "id": 230846807046819,
  "uuid": "6be605eb-df2e-4a72-8053-9ef611b59990",
  "is_folder": false,
  "content": {
    "_uid": "6f1c2a0e-3b7d-4c55-9a11-2d4e8b7a0c01",
    "answer": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "June to early October suits hiking, lake swimming and cable cars. Mountain huts mostly open for this season.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Winter brings skiing around Garmisch-Partenkirchen and quiet snow walks. Summer weekends are busy at Neuschwanstein and on the Königssee.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "question": "When is the best time to visit?",
    "component": "faq_item"
  },
