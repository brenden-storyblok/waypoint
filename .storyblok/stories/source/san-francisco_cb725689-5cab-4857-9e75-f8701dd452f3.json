    "summary": "More than 40 hills on a peninsula between the Pacific and the bay, climbed by cable cars since 1873. Eat sourdough and a Mission burrito, then walk the Golden Gate Bridge.",
    "component": "destination",
    "attributes": [
      "city",
      "coast",
      "food"
    ],
    "hero_image": {
      "id": 230952314625424,
      "alt": "The Golden Gate Bridge spans the strait from a rocky Marin headland, with the San Francisco skyline across the bay.",
      "name": "",
      "focus": "",
      "title": "",
      "source": "",
      "filename": "https://a.storyblok.com/f/295888311565739/22af639752/san-francisco-golden-gate.jpg",
