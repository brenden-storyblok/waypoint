  "content": {
    "_uid": "1486baf6-4459-4e5e-9386-aae0cbed3def",
    "name": "San Francisco",
    "usps": [
      {
        "_uid": "85479ad9-3192-412f-b97a-027a7f699989",
        "text": "The 1937 bridge is 2.7 km long, and you can cross it on foot or by bike.",
        "title": "Walk the Golden Gate",
        "component": "usp_item"
      },
      {
        "_uid": "2146439e-8d0a-402b-931f-e09364894d87",
        "text": "The Powell-Hyde, Powell-Mason and California Street cable car lines are a National Historic Landmark.",
        "title": "Ride a moving landmark",
        "component": "usp_item"
      },
      {
        "_uid": "280f5ff9-89f6-4992-8aa1-1a968b5370c8",
        "text": "Boats leave Pier 33 for the island's former federal prison, which closed in 1963.",
        "title": "Alcatraz by ferry",
        "component": "usp_item"
      },
      {
        "_uid": "30f6b1c6-a7b2-49d9-801a-51b57c183744",
        "text": "Order a Mission burrito on 24th Street, then try Boudin, which has baked sourdough since 1849.",
        "title": "Burritos and sourdough",
        "component": "usp_item"
      }
    ],
