{
  "name": "When is the best time to visit Santorini?",
  "parent_id": 230624347930176,
  "group_id": "6597917b-df72-49fc-8df9-1fcab8c4acf4",
  "alternates": [],
  "created_at": "2026-10-15T07:17:25.724Z",
  "deleted_at": null,
  "sort_by_date": null,
  "tag_list": [],
  "updated_at": "2026-11-10T20:57:38.088Z",
  "published_at": "2026-11-10T20:57:38.058Z",
  "id": 230846651308667,
  "uuid": "cc9ef600-c084-40c1-9ad1-b30eb12ecbe7",
  "is_folder": false,
  "content": {
    "_uid": "6f1c1c0e-3b0a-4d57-9a54-0a1d3b7f7a01",
    "answer": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Late April to early June and mid-September to October. The weather is warm enough for the beach and the paths are quieter.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "July and August are the hottest and busiest months. Many hotels and restaurants close from November to March.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "question": "When is the best time to visit?",
    "component": "faq_item",
    "answer__i18n__de": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Von Ende April bis Anfang Juni und von Mitte September bis Oktober. Das Wetter ist warm genug für den Strand, und auf den Wegen ist es ruhiger.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Juli und August sind die heißesten und vollsten Monate. Viele Hotels und Restaurants schließen von November bis März.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "answer__i18n__es": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "De finales de abril a principios de junio y de mediados de septiembre a octubre. Hace calor suficiente para la playa y los senderos están más tranquilos.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Julio y agosto son los meses más calurosos y con más gente. Muchos hoteles y restaurantes cierran de noviembre a marzo.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "answer__i18n__fr": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "De fin avril à début juin et de la mi-septembre à octobre. Il fait assez chaud pour la plage et les sentiers sont plus calmes.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Juillet et août sont les mois les plus chauds et les plus fréquentés. De nombreux hôtels et restaurants ferment de novembre à mars.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "question__i18n__de": "Wann ist die beste Reisezeit?",
    "question__i18n__es": "¿Cuál es la mejor época para visitar?",
    "question__i18n__fr": "Quelle est la meilleure période pour y aller ?"
  },
