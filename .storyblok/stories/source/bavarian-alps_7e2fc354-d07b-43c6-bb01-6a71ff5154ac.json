    "summary": "Limestone peaks, green lakes and a fairy-tale castle, all a train ride from Munich. Germany's high country, with a hut at the end of most trails.",
    "component": "destination",
    "attributes": [
      "nature",
      "mountains"
    ],
    "hero_image": {
      "id": 230846460334736,
      "alt": "St. Bartholomä pilgrimage church with red onion domes on the Königssee shore, with steep limestone mountains behind",
      "name": "",
      "focus": "",
      "title": "",
      "filename": "https://a.storyblok.com/f/295888311565739/971a0fde52/bavarian-alps-konigssee-st-bartholoma.jpg",
