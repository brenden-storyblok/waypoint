  "is_folder": false,
  "content": {
    "_uid": "7a2d3b1f-4c8e-4d66-8b22-3e5f9c8b1d01",
    "name": "Bavarian Alps",
    "usps": [
      {
        "_uid": "8b3e4c20-5d9f-4e77-9c33-4f6a0d9c2e01",
        "text": "The Zugspitze reaches 2,962 metres. Cable cars run to the summit from the Eibsee and from Garmisch.",
        "title": "Germany's highest peak",
        "component": "usp_item"
      },
      {
        "_uid": "8b3e4c20-5d9f-4e77-9c33-4f6a0d9c2e02",
        "text": "Electric boats cross the lake to St. Bartholomä, a church with red onion domes at the foot of the Watzmann massif.",
        "title": "A boat ride on the Königssee",
        "component": "usp_item"
      },
      {
        "_uid": "8b3e4c20-5d9f-4e77-9c33-4f6a0d9c2e03",
        "text": "Ludwig II began this hilltop castle in 1869. It stands near Füssen, above Hohenschwangau.",
        "title": "Neuschwanstein Castle",
        "component": "usp_item"
      },
      {
        "_uid": "8b3e4c20-5d9f-4e77-9c33-4f6a0d9c2e04",
        "text": "Marked trails link alpine huts that serve hot meals and offer beds. Book overnight stays ahead in summer.",
        "title": "Hut-to-hut hiking",
        "component": "usp_item"
      }
    ],
    "region": "Bavaria",
    "country": "germany",
