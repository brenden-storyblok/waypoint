  "content": {
    "_uid": "67f9bbb1-bcb2-4af2-bf6c-b847490d9d06",
    "name": "Dubrovnik",
    "usps": [
      {
        "_uid": "cf51fc1e-dd31-4f71-9fea-8c3b3d54ba7f",
        "text": "The city walls run for about 1,940 metres around the Old Town and rise up to 25 metres high.",
        "title": "Two kilometres of walls",
        "component": "usp_item"
      },
      {
        "_uid": "188550d9-916d-4945-b940-34c7f1696f76",
        "text": "The main street runs about 300 metres from the Pile Gate to the old port, paved in limestone worn smooth.",
        "title": "Polished Stradun",
        "component": "usp_item"
      },
      {
        "_uid": "f5e9759b-85b8-4976-a1ac-4f3868f29272",
        "text": "Boats from the old harbour reach the island's pine woods, rock pools and peacocks in about 15 minutes.",
        "title": "Lokrum by boat",
        "component": "usp_item"
      },
      {
        "_uid": "a578380d-db25-4a4e-aad3-ba4537f282e7",
        "text": "The cable car climbs to 405 metres on Mount Srđ for a view over the Old Town and the Elaphiti Islands.",
        "title": "Cable car to Srđ",
        "component": "usp_item"
      }
    ],
    "region": "Dalmatia",
