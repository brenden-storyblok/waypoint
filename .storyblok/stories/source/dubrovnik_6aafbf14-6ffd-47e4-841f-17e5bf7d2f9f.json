  "id": 230951348317386,
  "uuid": "6aafbf14-6ffd-47e4-841f-17e5bf7d2f9f",
  "is_folder": false,
  "content": {
    "_uid": "66e67f3f-1e67-49f8-a101-f0d9b65109eb",
    "body": [
      {
        "_uid": "c18f4d6b-96d5-43b7-9e3d-3d450092567e",
        "component": "destination_hero"
      },
      {
        "_uid": "e7b28121-a6ca-43b4-ad17-bd98a65d2270",
        "headline": "Why Dubrovnik",
        "component": "destination_usps",
        "headline__i18n__de": "Warum Dubrovnik",
        "headline__i18n__es": "Por qué Dubrovnik",
        "headline__i18n__fr": "Pourquoi Dubrovnik"
      },
      {
        "_uid": "324bd8d4-1a5d-475d-82d4-9e4e91f2d111",
        "headline": "About Dubrovnik",
        "component": "destination_bio",
        "headline__i18n__de": "Über Dubrovnik",
        "headline__i18n__es": "Sobre Dubrovnik",
        "headline__i18n__fr": "À propos de Dubrovnik"
      },
      {
        "_uid": "92428a9d-55e2-4877-b04b-49652189c327",
        "headline": "Dubrovnik in pictures",
        "component": "destination_gallery",
        "headline__i18n__de": "Dubrovnik in Bildern",
        "headline__i18n__es": "Dubrovnik en imágenes",
        "headline__i18n__fr": "Dubrovnik en images"
      },
      {
        "_uid": "4ff57340-47ae-4952-8b11-0e7caa676971",
        "text": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "The Old Town is car-free, so walk it. Libertas city buses link the Pile Gate with the Gruž ferry port, Lapad and the hotels along the coast.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "The airport shuttle bus reaches the Pile Gate in about 30 minutes.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "City buses from Gruž port to the Pile Gate take about 15 minutes.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "The cable car ride up Mount Srđ takes about 4 minutes.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "headline": "Getting around",
        "component": "text_block",
        "text__i18n__de": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Die Altstadt ist autofrei, also geh zu Fuß. Die Stadtbusse von Libertas verbinden das Pile-Tor mit dem Fährhafen Gruž, mit Lapad und mit den Hotels entlang der Küste.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Der Flughafenbus erreicht das Pile-Tor in etwa 30 Minuten.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Die Stadtbusse vom Hafen Gruž zum Pile-Tor brauchen etwa 15 Minuten.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Die Fahrt mit der Seilbahn auf den Srđ dauert etwa 4 Minuten.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "text__i18n__es": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "El casco antiguo es peatonal, así que recórrelo a pie. Los autobuses urbanos de Libertas conectan la puerta de Pile con el puerto de ferris de Gruž, Lapad y los hoteles de la costa.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "El autobús lanzadera del aeropuerto llega a la puerta de Pile en unos 30 minutos.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Los autobuses urbanos del puerto de Gruž a la puerta de Pile tardan unos 15 minutos.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "El trayecto en teleférico hasta el monte Srđ dura unos 4 minutos.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "text__i18n__fr": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "La vieille ville est piétonne : parcourez-la à pied. Les bus urbains Libertas relient la porte de Pile au port de ferries de Gruž, à Lapad et aux hôtels le long de la côte.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "La navette de l'aéroport atteint la porte de Pile en 30 minutes environ.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Les bus urbains du port de Gruž à la porte de Pile mettent environ 15 minutes.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "La montée en téléphérique jusqu'au mont Srđ dure environ 4 minutes.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "headline__i18n__de": "Unterwegs",
        "headline__i18n__es": "Cómo moverse",
        "headline__i18n__fr": "Se déplacer"
      }
