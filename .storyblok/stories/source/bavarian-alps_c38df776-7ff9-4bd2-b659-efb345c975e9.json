  "is_folder": false,
  "content": {
    "_uid": "9c4f5d31-6e0a-4f88-ad44-5a7b1e0d3f01",
    "body": [
      {
        "_uid": "ad5a6e42-7f1b-4a99-be55-6b8c2f1e4a01",
        "component": "destination_hero"
      },
      {
        "_uid": "ad5a6e42-7f1b-4a99-be55-6b8c2f1e4a02",
        "headline": "Why Bavarian Alps",
        "component": "destination_usps",
        "headline__i18n__de": "Warum die Bayerischen Alpen",
        "headline__i18n__es": "Por qué los Alpes bávaros",
        "headline__i18n__fr": "Pourquoi les Alpes bavaroises"
      },
      {
        "_uid": "ad5a6e42-7f1b-4a99-be55-6b8c2f1e4a03",
        "headline": "About Bavarian Alps",
        "component": "destination_bio",
        "headline__i18n__de": "Über die Bayerischen Alpen",
        "headline__i18n__es": "Sobre los Alpes bávaros",
        "headline__i18n__fr": "À propos des Alpes bavaroises"
      },
      {
        "_uid": "ad5a6e42-7f1b-4a99-be55-6b8c2f1e4a04",
        "headline": "Bavarian Alps in pictures",
        "component": "destination_gallery",
        "headline__i18n__de": "Die Bayerischen Alpen in Bildern",
        "headline__i18n__es": "Los Alpes bávaros en imágenes",
        "headline__i18n__fr": "Les Alpes bavaroises en images"
      },
      {
        "_uid": "ad5a6e42-7f1b-4a99-be55-6b8c2f1e4a05",
        "text": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Trains and buses reach most sights. A Bayern-Ticket covers regional trains and many local buses for a day.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Regional trains run from Munich to Garmisch-Partenkirchen and to Berchtesgaden.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "RVO buses link villages, lakes and trailheads.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Cable cars save the steepest climbs and run to the Zugspitze summit.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "headline": "Getting around",
        "component": "text_block",
        "text__i18n__de": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Züge und Busse erreichen die meisten Sehenswürdigkeiten. Ein Bayern-Ticket gilt einen Tag lang für Regionalzüge und viele Ortsbusse.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Regionalzüge fahren von München nach Garmisch-Partenkirchen und nach Berchtesgaden.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "RVO-Busse verbinden Dörfer, Seen und Wanderausgangspunkte.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Seilbahnen ersparen die steilsten Anstiege und fahren bis zum Zugspitzgipfel.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "text__i18n__es": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Los trenes y autobuses llegan a casi todos los lugares de interés. Un Bayern-Ticket cubre durante un día los trenes regionales y muchos autobuses locales.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Los trenes regionales circulan de Múnich a Garmisch-Partenkirchen y a Berchtesgaden.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Los autobuses RVO conectan pueblos, lagos y puntos de partida de rutas.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Los teleféricos ahorran las subidas más empinadas y llegan hasta la cumbre de la Zugspitze.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "text__i18n__fr": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Les trains et les bus desservent la plupart des sites. Un Bayern-Ticket couvre pendant une journée les trains régionaux et de nombreux bus locaux.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Des trains régionaux relient Munich à Garmisch-Partenkirchen et à Berchtesgaden.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Les bus RVO relient villages, lacs et départs de sentiers.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Les téléphériques évitent les montées les plus raides et vont jusqu'au sommet de la Zugspitze.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "headline__i18n__de": "Unterwegs",
        "headline__i18n__es": "Cómo moverse",
        "headline__i18n__fr": "Se déplacer"
      },
