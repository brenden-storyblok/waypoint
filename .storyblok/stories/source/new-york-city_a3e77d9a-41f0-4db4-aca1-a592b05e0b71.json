      },
      {
        "_uid": "0059b06a-d8b1-4f34-b728-a0773310054b",
        "headline": "Why New York City",
        "component": "destination_usps"
      },
      {
        "_uid": "adda625c-d719-4a1f-a2cb-e6707a5f09be",
        "headline": "About New York City",
        "component": "destination_bio"
      },
      {
        "_uid": "5c53e91e-1dbd-4657-b0c4-ec2f2603374d",
        "headline": "New York City in pictures",
        "component": "destination_gallery"
      },
      {
        "_uid": "bca4e9c4-718b-4017-a2d7-894e7cc82313",
        "text": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "The subway runs 24 hours a day. Tap a contactless card or phone on the OMNY reader; after 12 paid rides in 7 days, the rest of that week rides free.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "AirTrain and subway from JFK to Midtown take about 60 minutes.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "The free Staten Island Ferry crosses the harbour in 25 minutes and passes the Statue of Liberty.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Twenty Manhattan street blocks north or south make about 1.6 km.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "headline": "Getting around",
        "component": "text_block"
      }
    ],
    "component": "destination_page",
    "destination": "00c09d68-57ae-46e2-945d-154779d68fd1"
