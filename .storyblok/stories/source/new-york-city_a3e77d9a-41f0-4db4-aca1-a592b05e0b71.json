  "id": 230950933601132,
  "uuid": "a3e77d9a-41f0-4db4-aca1-a592b05e0b71",
  "is_folder": false,
  "content": {
    "_uid": "9864e697-d57d-4520-8951-04fedb78743f",
    "body": [
      {
        "_uid": "2940b19a-a1b9-438c-8f41-7ebe3775e715",
        "component": "destination_hero"
      },
      {
        "_uid": "0059b06a-d8b1-4f34-b728-a0773310054b",
        "headline": "Why New York City",
        "component": "destination_usps",
        "headline__i18n__de": "Warum New York City",
        "headline__i18n__es": "Por qué Nueva York",
        "headline__i18n__fr": "Pourquoi New York"
      },
      {
        "_uid": "adda625c-d719-4a1f-a2cb-e6707a5f09be",
        "headline": "About New York City",
        "component": "destination_bio",
        "headline__i18n__de": "Über New York City",
        "headline__i18n__es": "Sobre Nueva York",
        "headline__i18n__fr": "À propos de New York"
      },
      {
        "_uid": "5c53e91e-1dbd-4657-b0c4-ec2f2603374d",
        "headline": "New York City in pictures",
        "component": "destination_gallery",
        "headline__i18n__de": "New York City in Bildern",
        "headline__i18n__es": "Nueva York en imágenes",
        "headline__i18n__fr": "New York en images"
      },
      {
        "_uid": "bca4e9c4-718b-4017-a2d7-894e7cc82313",
        "text": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "The subway runs 24 hours a day. Tap a contactless card or phone on the OMNY reader; after 12 paid rides in 7 days, the rest of that week rides free.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "AirTrain and subway from JFK to Midtown take about 60 minutes.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "The free Staten Island Ferry crosses the harbour in 25 minutes and passes the Statue of Liberty.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Twenty Manhattan street blocks north or south make about 1.6 km.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "headline": "Getting around",
        "component": "text_block",
        "text__i18n__de": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Die U-Bahn fährt rund um die Uhr. Halte eine kontaktlose Karte oder dein Smartphone an das OMNY-Lesegerät; nach 12 bezahlten Fahrten innerhalb von 7 Tagen sind alle weiteren Fahrten dieser Woche kostenlos.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Mit AirTrain und U-Bahn dauert die Fahrt vom JFK nach Midtown etwa 60 Minuten.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Die kostenlose Staten Island Ferry quert den Hafen in 25 Minuten und fährt an der Freiheitsstatue vorbei.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Zwanzig Straßenblöcke in Manhattan nach Norden oder Süden entsprechen etwa 1,6 km.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "text__i18n__es": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "El metro funciona las 24 horas del día. Acerca una tarjeta sin contacto o el móvil al lector OMNY; tras 12 viajes pagados en 7 días, el resto de los viajes de esa semana son gratis.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "El AirTrain y el metro desde el JFK hasta Midtown tardan unos 60 minutos.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "El ferri gratuito de Staten Island cruza el puerto en 25 minutos y pasa junto a la Estatua de la Libertad.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Veinte manzanas de Manhattan hacia el norte o el sur equivalen a unos 1,6 km.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "text__i18n__fr": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Le métro fonctionne 24 heures sur 24. Passez une carte sans contact ou votre téléphone sur le lecteur OMNY ; après 12 trajets payés en 7 jours, les trajets suivants de la semaine sont gratuits.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "L'AirTrain et le métro entre JFK et Midtown prennent environ 60 minutes.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Le ferry gratuit de Staten Island traverse la baie en 25 minutes et passe devant la statue de la Liberté.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Vingt blocs de rues de Manhattan vers le nord ou le sud représentent environ 1,6 km.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "headline__i18n__de": "Unterwegs",
        "headline__i18n__es": "Cómo moverse",
        "headline__i18n__fr": "Se déplacer"
      }
