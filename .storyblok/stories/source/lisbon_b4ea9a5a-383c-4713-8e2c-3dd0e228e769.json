        "component": "destination_usps"
      },
      {
        "_uid": "aa9387f8-75bd-4e14-a2dc-6f928417e713",
        "headline": "About Lisbon",
        "component": "destination_bio"
      },
      {
        "_uid": "1b2deebe-e8d5-43e2-b239-a38e9b31f84f",
        "headline": "Lisbon in pictures",
        "component": "destination_gallery"
      },
      {
        "_uid": "83d20b83-7b6d-4795-b3ed-ee0d4f8b78de",
        "text": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "A Viva Viagem card covers the metro, trams, buses and the Santa Justa lift. Load it with zapping credit and tap in.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Metro from the airport to the centre takes about 25 minutes.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Ferries cross to Cacilhas every 10 to 20 minutes.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Funiculars save the steepest climbs in Bica and Glória.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "headline": "Getting around",
        "component": "text_block"
      },
