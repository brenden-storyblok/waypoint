  "is_folder": false,
  "content": {
    "_uid": "edfe297d-953b-4ac4-b7a3-1950f15e5325",
    "body": [
      {
        "_uid": "3748cf41-2be3-4b10-b984-24c9df6eb39f",
        "component": "destination_hero"
      },
      {
        "_uid": "080b6525-dd4c-414f-ae7c-0edc26fabb2b",
        "headline": "Why Lisbon",
        "component": "destination_usps",
        "headline__i18n__de": "Warum Lissabon",
        "headline__i18n__es": "Por qué Lisboa",
        "headline__i18n__fr": "Pourquoi Lisbonne"
      },
      {
        "_uid": "aa9387f8-75bd-4e14-a2dc-6f928417e713",
        "headline": "About Lisbon",
        "component": "destination_bio",
        "headline__i18n__de": "Über Lissabon",
        "headline__i18n__es": "Sobre Lisboa",
        "headline__i18n__fr": "À propos de Lisbonne"
      },
      {
        "_uid": "1b2deebe-e8d5-43e2-b239-a38e9b31f84f",
        "headline": "Lisbon in pictures",
        "component": "destination_gallery",
        "headline__i18n__de": "Lissabon in Bildern",
        "headline__i18n__es": "Lisboa en imágenes",
        "headline__i18n__fr": "Lisbonne en images"
      },
      {
        "_uid": "83d20b83-7b6d-4795-b3ed-ee0d4f8b78de",
        "text": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "A Viva Viagem card covers the metro, trams, buses and the Santa Justa lift. Load it with zapping credit and tap in.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Metro from the airport to the centre takes about 25 minutes.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Ferries cross to Cacilhas every 10 to 20 minutes.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Funiculars save the steepest climbs in Bica and Glória.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "headline": "Getting around",
        "component": "text_block",
        "text__i18n__de": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Eine Viva-Viagem-Karte gilt für Metro, Straßenbahnen, Busse und den Santa-Justa-Aufzug. Lade sie mit Zapping-Guthaben auf und halte sie beim Einsteigen an das Lesegerät.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Die Metro vom Flughafen ins Zentrum braucht etwa 25 Minuten.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Fähren setzen alle 10 bis 20 Minuten nach Cacilhas über.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Standseilbahnen ersparen die steilsten Anstiege in Bica und Glória.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "text__i18n__es": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "La tarjeta Viva Viagem sirve para el metro, los tranvías, los autobuses y el ascensor de Santa Justa. Cárgala con saldo zapping y valida al entrar.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "El metro del aeropuerto al centro tarda unos 25 minutos.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Los ferris cruzan a Cacilhas cada 10 a 20 minutos.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Los funiculares ahorran las subidas más empinadas en Bica y Glória.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "text__i18n__fr": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Une carte Viva Viagem donne accès au métro, aux tramways, aux bus et à l'ascenseur de Santa Justa. Rechargez-la en crédit zapping et validez-la à l'entrée.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Le métro de l'aéroport au centre prend environ 25 minutes.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Des ferries traversent vers Cacilhas toutes les 10 à 20 minutes.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Les funiculaires évitent les montées les plus raides à Bica et à Glória.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "headline__i18n__de": "Unterwegs",
        "headline__i18n__es": "Cómo moverse",
        "headline__i18n__fr": "Se déplacer"
      },
