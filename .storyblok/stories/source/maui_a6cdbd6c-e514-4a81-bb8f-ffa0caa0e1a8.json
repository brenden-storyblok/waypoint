  "is_folder": false,
  "content": {
    "_uid": "9875dd51-b33e-4d46-a072-967fa4c6f395",
    "body": [
      {
        "_uid": "ce597a2d-96d3-4931-9245-474075e44c94",
        "component": "destination_hero"
      },
      {
        "_uid": "f46f05a5-1556-4809-80bd-2514aaac1aca",
        "headline": "Why Maui",
        "component": "destination_usps",
        "headline__i18n__de": "Warum Maui",
        "headline__i18n__es": "Por qué Maui",
        "headline__i18n__fr": "Pourquoi Maui"
      },
      {
        "_uid": "6cd50f9d-a4f0-42ad-af6c-213356c17fb9",
        "headline": "About Maui",
        "component": "destination_bio",
        "headline__i18n__de": "Über Maui",
        "headline__i18n__es": "Sobre Maui",
        "headline__i18n__fr": "À propos de Maui"
      },
      {
        "_uid": "e8afc27b-7f14-40a0-9434-357498f1d954",
        "headline": "Maui in pictures",
        "component": "destination_gallery",
        "headline__i18n__de": "Maui in Bildern",
        "headline__i18n__es": "Maui en imágenes",
        "headline__i18n__fr": "Maui en images"
      },
      {
        "_uid": "ade218ce-62ab-4cd4-b176-e6615d06bfc2",
        "text": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Rent a car at Kahului Airport (OGG). The Maui Bus links the main towns, but routes thin out beyond the central valley and the resort coasts.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Kahului Airport to Wailea takes about 30 minutes by car.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Kahului to Kāʻanapali takes about 45 minutes on the Honoapiʻilani Highway.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Kahului to the Haleakalā summit takes about 2 hours up a road of switchbacks.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "headline": "Getting around",
        "component": "text_block",
        "text__i18n__de": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Miete am Flughafen Kahului (OGG) ein Auto. Der Maui Bus verbindet die größeren Orte, doch jenseits des zentralen Tals und der Resortküsten wird das Netz dünn.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Vom Flughafen Kahului nach Wailea sind es mit dem Auto etwa 30 Minuten.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Von Kahului nach Kāʻanapali braucht man auf dem Honoapiʻilani Highway etwa 45 Minuten.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Von Kahului zum Gipfel des Haleakalā sind es etwa 2 Stunden auf einer Straße mit Serpentinen.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "text__i18n__es": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Alquila un coche en el aeropuerto de Kahului (OGG). El Maui Bus conecta las principales localidades, pero las rutas escasean más allá del valle central y las costas turísticas.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Del aeropuerto de Kahului a Wailea se tardan unos 30 minutos en coche.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "De Kahului a Kāʻanapali se tardan unos 45 minutos por la Honoapiʻilani Highway.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "De Kahului a la cumbre del Haleakalā se tardan unas 2 horas por una carretera de curvas cerradas.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "text__i18n__fr": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Louez une voiture à l'aéroport de Kahului (OGG). Le Maui Bus relie les principales villes, mais les lignes se font rares au-delà de la vallée centrale et des côtes balnéaires.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "De l'aéroport de Kahului à Wailea, comptez environ 30 minutes en voiture.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "De Kahului à Kāʻanapali, comptez environ 45 minutes par la Honoapiʻilani Highway.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "De Kahului au sommet du Haleakalā, comptez environ 2 heures sur une route en lacets.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "headline__i18n__de": "Unterwegs",
        "headline__i18n__es": "Cómo moverse",
        "headline__i18n__fr": "Se déplacer"
      }
    ],
