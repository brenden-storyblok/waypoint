        "headline": "Why Maui",
        "component": "destination_usps"
      },
      {
        "_uid": "6cd50f9d-a4f0-42ad-af6c-213356c17fb9",
        "headline": "About Maui",
        "component": "destination_bio"
      },
      {
        "_uid": "e8afc27b-7f14-40a0-9434-357498f1d954",
        "headline": "Maui in pictures",
        "component": "destination_gallery"
      },
      {
        "_uid": "ade218ce-62ab-4cd4-b176-e6615d06bfc2",
        "text": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Rent a car at Kahului Airport (OGG). The Maui Bus links the main towns, but routes thin out beyond the central valley and the resort coasts.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Kahului Airport to Wailea takes about 30 minutes by car.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Kahului to Kāʻanapali takes about 45 minutes on the Honoapiʻilani Highway.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Kahului to the Haleakalā summit takes about 2 hours up a road of switchbacks.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "headline": "Getting around",
        "component": "text_block"
      }
    ],
    "component": "destination_page",
    "destination": "5c8dd6a9-6053-4ff1-be1a-b29ac8ea7ebd"
