  "content": {
    "_uid": "503d21e2-a460-40e2-acfd-6b75f1ad49d3",
    "name": "Scottish Highlands",
    "usps": [
      {
        "_uid": "e2076435-4a9c-400c-802f-9669a5ef24da",
        "text": "Ben Nevis tops out at 1,345 metres, and the Mountain Track up from Glen Nevis takes most of a day.",
        "title": "Britain's highest summit",
        "component": "usp_item"
      },
      {
        "_uid": "0f1d101d-0bd9-41fd-bdd2-d7a9fcae42e2",
        "text": "Eilean Donan was rebuilt between 1912 and 1932, while Kilchurn on Loch Awe is a 15th-century Campbell ruin.",
        "title": "Castles on the lochs",
        "component": "usp_item"
      },
      {
        "_uid": "dab98f3d-b1a7-4fe6-b7c2-6f7a5cc550a3",
        "text": "Summer steam trains cross the 21-arch Glenfinnan Viaduct on the line from Fort William to Mallaig.",
        "title": "The Jacobite steam train",
        "component": "usp_item"
      },
      {
        "_uid": "2c9b80ec-08f7-4e03-af49-54729ab8f6ab",
        "text": "Speyside, on the eastern side of the Highlands, has more malt distilleries than any other Scotch whisky region.",
        "title": "Whisky country",
        "component": "usp_item"
      }
    ],
    "region": "Scotland",
    "country": "united-kingdom",
