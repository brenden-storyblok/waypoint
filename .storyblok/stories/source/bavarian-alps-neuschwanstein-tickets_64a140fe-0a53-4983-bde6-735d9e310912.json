{
  "name": "Can I visit Neuschwanstein without a ticket booked ahead?",
  "parent_id": 230624347930176,
  "group_id": "49432987-3bd9-42d2-af91-df294d1a7e99",
  "alternates": [],
  "created_at": "2026-10-15T07:18:05.986Z",
