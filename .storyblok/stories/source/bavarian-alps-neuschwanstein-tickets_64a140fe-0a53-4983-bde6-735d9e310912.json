{
  "name": "Can I visit Neuschwanstein without a ticket booked ahead?",
  "parent_id": 230624347930176,
  "group_id": "49432987-3bd9-42d2-af91-df294d1a7e99",
  "alternates": [],
  "created_at": "2026-10-15T07:18:05.986Z",
  "deleted_at": null,
  "sort_by_date": null,
  "tag_list": [],
  "updated_at": "2026-11-10T21:06:10.610Z",
  "published_at": "2026-11-10T21:06:10.582Z",
  "id": 230846816234151,
  "uuid": "64a140fe-0a53-4983-bde6-735d9e310912",
  "is_folder": false,
  "content": {
    "_uid": "6f1c2a0e-3b7d-4c55-9a11-2d4e8b7a0c03",
    "answer": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "You can walk up and see the castle from outside without a ticket. Entry to the rooms is by timed guided tour only.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Book online ahead in season. Walk-up tickets at the ticket centre in Hohenschwangau often sell out.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "question": "Can I visit Neuschwanstein without a ticket booked ahead?",
    "component": "faq_item",
    "answer__i18n__de": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Du kannst ohne Ticket zum Schloss hinaufgehen und es von außen ansehen. Der Zutritt zu den Räumen ist nur mit einer Führung zu festen Zeiten möglich.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Buche in der Saison vorab online. Tickets vor Ort im Ticket-Center in Hohenschwangau sind oft ausverkauft.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "answer__i18n__es": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Puedes subir y ver el castillo desde fuera sin entrada. El acceso a las salas es solo mediante visita guiada con horario fijo.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Reserva en línea con antelación en temporada. Las entradas que se venden en persona en el centro de venta de entradas de Hohenschwangau suelen agotarse.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "answer__i18n__fr": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Vous pouvez monter voir le château de l'extérieur sans billet. L'accès aux salles se fait uniquement par visite guidée à horaire fixe.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Réservez en ligne à l'avance en saison. Les billets vendus sur place au centre de billetterie de Hohenschwangau sont souvent épuisés.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "question__i18n__de": "Kann ich Schloss Neuschwanstein ohne vorab gebuchtes Ticket besichtigen?",
    "question__i18n__es": "¿Puedo visitar Neuschwanstein sin una entrada reservada con antelación?",
    "question__i18n__fr": "Puis-je visiter Neuschwanstein sans billet réservé à l'avance ?"
  },
