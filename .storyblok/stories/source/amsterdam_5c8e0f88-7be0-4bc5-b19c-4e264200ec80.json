  "id": 230952454102689,
  "uuid": "5c8e0f88-7be0-4bc5-b19c-4e264200ec80",
  "is_folder": false,
  "content": {
    "_uid": "d1306686-ebb4-41aa-bbd9-347b421f617e",
    "body": [
      {
        "_uid": "7a5ddb50-8fbf-4547-af78-2ba28f83e572",
        "component": "destination_hero"
      },
      {
        "_uid": "0518ae9b-0037-4eb9-a7d3-57f87076555c",
        "headline": "Why Amsterdam",
        "component": "destination_usps",
        "headline__i18n__de": "Warum Amsterdam",
        "headline__i18n__es": "Por qué Ámsterdam",
        "headline__i18n__fr": "Pourquoi Amsterdam"
      },
      {
        "_uid": "60e6ecf7-707a-4792-a323-fe50ba8433be",
        "headline": "About Amsterdam",
        "component": "destination_bio",
        "headline__i18n__de": "Über Amsterdam",
        "headline__i18n__es": "Sobre Ámsterdam",
        "headline__i18n__fr": "À propos d'Amsterdam"
      },
      {
        "_uid": "0edff29c-f9cf-4fba-a3f0-3165a71ab42a",
        "headline": "Amsterdam in pictures",
        "component": "destination_gallery",
        "headline__i18n__de": "Amsterdam in Bildern",
        "headline__i18n__es": "Ámsterdam en imágenes",
        "headline__i18n__fr": "Amsterdam en images"
      },
      {
        "_uid": "985c7101-e111-48e9-a87c-ef849c8a7ef5",
        "text": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "GVB runs the trams, metro, buses and the free ferries across the IJ. Tap in and out with a contactless bank card or buy a GVB day ticket, and rent a bike for the canal ring.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Trains from Schiphol Airport to Centraal Station take about 15 minutes.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "The free ferry from behind Centraal Station to Buiksloterweg in Noord crosses in about 5 minutes.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Cycling from Centraal Station to the Rijksmuseum covers about 3 km and takes about 15 minutes.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "headline": "Getting around",
        "component": "text_block",
        "text__i18n__de": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Die GVB betreibt Straßenbahnen, U-Bahn, Busse und die kostenlosen Fähren über das IJ. Checke mit einer kontaktlosen Bankkarte ein und aus oder kaufe ein GVB-Tagesticket, und miete ein Fahrrad für den Grachtengürtel.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Züge vom Flughafen Schiphol zum Centraal Station brauchen etwa 15 Minuten.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Die kostenlose Fähre von hinter dem Centraal Station nach Buiksloterweg in Noord setzt in etwa 5 Minuten über.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Mit dem Rad vom Centraal Station zum Rijksmuseum sind es etwa 3 km, die Fahrt dauert etwa 15 Minuten.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "text__i18n__es": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "GVB gestiona los tranvías, el metro, los autobuses y los ferris gratuitos que cruzan el IJ. Pasa la tarjeta bancaria sin contacto al entrar y al salir, o compra un billete de día de GVB, y alquila una bicicleta para recorrer el anillo de canales.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Los trenes del aeropuerto de Schiphol a la Estación Central tardan unos 15 minutos.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "El ferri gratuito desde la parte trasera de la Estación Central hasta Buiksloterweg, en Noord, cruza en unos 5 minutos.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "En bicicleta, de la Estación Central al Rijksmuseum hay unos 3 km y se tardan unos 15 minutos.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "text__i18n__fr": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "La GVB exploite les tramways, le métro, les bus et les ferries gratuits qui traversent l'IJ. Validez avec une carte bancaire sans contact à l'entrée et à la sortie ou achetez un ticket journée GVB, et louez un vélo pour parcourir la ceinture de canaux.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Les trains de l'aéroport de Schiphol à la gare centrale mettent environ 15 minutes.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Le ferry gratuit au départ de l'arrière de la gare centrale vers Buiksloterweg, dans le Noord, traverse en 5 minutes environ.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "À vélo, de la gare centrale au Rijksmuseum, il y a environ 3 km et il faut compter 15 minutes.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "headline__i18n__de": "Unterwegs",
        "headline__i18n__es": "Cómo moverse",
        "headline__i18n__fr": "Se déplacer"
      }
