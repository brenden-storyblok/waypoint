  "is_folder": false,
  "content": {
    "_uid": "a8c47985-0ee6-4125-a749-2682f08b58cb",
    "answer": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "For the hill villages and lavender fields, yes. Rail does not reach them and buses run infrequently.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "You can do Aix-en-Provence and Avignon without one. Both have TGV stations.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "question": "Do I need a car?",
