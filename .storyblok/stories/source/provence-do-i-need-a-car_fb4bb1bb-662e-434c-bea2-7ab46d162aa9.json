{
  "name": "Do I need a car in Provence?",
  "parent_id": 230624347930176,
  "group_id": "3ddaf91a-41b6-4486-88e1-79064757f3d2",
  "alternates": [],
  "created_at": "2026-10-15T07:18:11.558Z",
  "deleted_at": null,
  "sort_by_date": null,
  "tag_list": [],
  "updated_at": "2026-11-10T20:56:26.824Z",
  "published_at": "2026-11-10T20:56:26.799Z",
  "id": 230846839052969,
  "uuid": "fb4bb1bb-662e-434c-bea2-7ab46d162aa9",
  "is_folder": false,
  "content": {
    "_uid": "a8c47985-0ee6-4125-a749-2682f08b58cb",
    "answer": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "For the hill villages and lavender fields, yes. Rail does not reach them and buses run infrequently.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "You can do Aix-en-Provence and Avignon without one. Both have TGV stations.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "question": "Do I need a car?",
    "component": "faq_item",
    "answer__i18n__de": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Für die Bergdörfer und Lavendelfelder: ja. Die Bahn fährt dorthin nicht, und Busse verkehren selten.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Aix-en-Provence und Avignon lassen sich auch ohne Auto besuchen. Beide haben einen TGV-Bahnhof.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "answer__i18n__es": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Para los pueblos de montaña y los campos de lavanda, sí. El tren no llega hasta allí y los autobuses pasan con poca frecuencia.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Puedes visitar Aix-en-Provence y Aviñón sin coche. Ambas tienen estación de TGV.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "answer__i18n__fr": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Pour les villages perchés et les champs de lavande, oui. Le train n'y va pas et les bus sont peu fréquents.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Vous pouvez visiter Aix-en-Provence et Avignon sans voiture. Les deux ont une gare TGV.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "question__i18n__de": "Brauche ich ein Auto?",
    "question__i18n__es": "¿Necesito coche?",
    "question__i18n__fr": "Ai-je besoin d'une voiture ?"
  },
