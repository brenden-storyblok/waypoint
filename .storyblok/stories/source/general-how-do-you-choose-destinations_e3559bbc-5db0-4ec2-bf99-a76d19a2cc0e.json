{
  "name": "How do you choose destinations?",
  "parent_id": 230624347930176,
  "group_id": "63f99ae1-2d5a-4230-83ab-7a22d2c20130",
  "alternates": [],
  "created_at": "2026-10-15T07:15:34.561Z",
  "deleted_at": null,
  "sort_by_date": null,
  "tag_list": [],
  "updated_at": "2026-11-10T21:06:47.976Z",
  "published_at": "2026-11-10T21:06:47.948Z",
  "id": 230846195997282,
  "uuid": "e3559bbc-5db0-4ec2-bf99-a76d19a2cc0e",
  "is_folder": false,
  "content": {
    "_uid": "a1d4c7e2-5b3f-4c1a-9e60-1f2b7a8c0d11",
    "answer": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Our editors pick places they have visited in more than one season.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "We add a destination only after it has earned a second trip.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "question": "How do you choose destinations?",
    "component": "faq_item",
    "answer__i18n__de": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Unsere Redakteurinnen und Redakteure wählen Orte aus, die sie in mehr als einer Jahreszeit besucht haben.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Wir nehmen ein Reiseziel erst auf, wenn es sich eine zweite Reise verdient hat.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "answer__i18n__es": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Nuestros editores eligen lugares que han visitado en más de una estación.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Solo añadimos un destino cuando se ha ganado un segundo viaje.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "answer__i18n__fr": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Nos rédacteurs choisissent des lieux qu'ils ont visités à plus d'une saison.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Nous n'ajoutons une destination qu'après qu'elle a mérité un second voyage.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "question__i18n__de": "Wie wählt ihr Reiseziele aus?",
    "question__i18n__es": "¿Cómo eligen los destinos?",
    "question__i18n__fr": "Comment choisissez-vous les destinations ?"
  },
