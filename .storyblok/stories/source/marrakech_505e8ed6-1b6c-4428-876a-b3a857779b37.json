  "content": {
    "_uid": "15af760f-8413-4023-9176-7a382f5cf0c0",
    "name": "Marrakech",
    "usps": [
      {
        "_uid": "a8a6925b-fcae-452e-8820-76cc7a790399",
        "text": "Food stalls set up in the main square each evening, serving harira, snail broth and grilled merguez.",
        "title": "Jemaa el-Fna after dark",
        "component": "usp_item"
      },
      {
        "_uid": "680cdbcf-b08c-48d8-9b17-a9d2a1954155",
        "text": "The 12th-century Almohad tower stands about 77 metres tall and served as a model for the Giralda in Seville.",
        "title": "The Koutoubia minaret",
        "component": "usp_item"
      },
      {
        "_uid": "e3b5d103-8103-4139-b505-a4b762903534",
        "text": "This 16th-century Saadian college of carved cedar and zellige once housed up to 900 students.",
        "title": "Ben Youssef Madrasa",
        "component": "usp_item"
      },
      {
        "_uid": "5b123b04-aae6-4167-a70f-429a4065bc8f",
        "text": "The stony Agafay desert lies about 40 km southwest, close enough for a night in a desert camp.",
        "title": "Desert on the doorstep",
        "component": "usp_item"
      }
    ],
    "region": "Marrakech-Safi",
    "country": "morocco",
