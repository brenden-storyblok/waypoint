    "summary": "Japan's capital for more than a thousand years, with temple bells, wooden teahouses and torii tunnels up the hills. A city you learn on foot and by bus.",
    "component": "destination",
    "attributes": [
      "city",
      "culture",
      "food"
    ],
    "hero_image": {
      "id": 230948370107253,
      "alt": "The Kiyomizu-dera pagoda stands above autumn trees with Kyoto and its western mountains behind at dusk.",
      "name": "",
      "focus": "",
      "title": "",
      "source": "",
      "filename": "https://a.storyblok.com/f/295888311565739/3da4435b8f/kyoto-kiyomizu.jpg",
      "copyright": "Su San Lee / Unsplash",
