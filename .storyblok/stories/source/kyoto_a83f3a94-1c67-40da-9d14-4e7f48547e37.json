  "content": {
    "_uid": "a8bb5f36-4902-4da2-85e3-749a733e55e8",
    "name": "Kyoto",
    "usps": [
      {
        "_uid": "ab53ec10-8471-438c-9095-d39a6c8f6cbb",
        "text": "Emperors ruled from Kyoto from 794 until the court moved to Tokyo in 1868.",
        "title": "A thousand years of capital",
        "component": "usp_item"
      },
      {
        "_uid": "1af2e978-bdbb-4a48-8d85-0a73bf5848ea",
        "text": "Thousands of vermilion gates line the trails that climb Mount Inari behind Fushimi Inari Taisha.",
        "title": "Torii up the mountain",
        "component": "usp_item"
      },
      {
        "_uid": "55cd1f95-2fb2-4cb4-b157-37f38bee0776",
        "text": "Nishiki Market runs five blocks through the centre, selling pickles, tofu, sweets and grilled skewers.",
        "title": "Kyoto's Kitchen",
        "component": "usp_item"
      },
      {
        "_uid": "abf7e3f1-8c0a-4c7b-907c-820481d70e70",
        "text": "Kinkaku-ji's top two floors are covered in gold leaf and reflect in the Kyoko-chi pond.",
        "title": "Gold on the water",
        "component": "usp_item"
      }
    ],
    "region": "Kansai",
    "country": "japan",
