  "id": 230847310150332,
  "uuid": "e46431f0-5a2d-42fa-ac57-b7ff018cc1fa",
  "is_folder": false,
  "content": {
    "_uid": "c1aad5e7-ef9e-4941-8223-9e2cf5e66706",
    "answer": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "No. The coast road, the SS163, is narrow and slow in summer, and parking in the towns is scarce and costly.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "SITA buses and seasonal ferries link the main towns.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "question": "Do I need a car?",
