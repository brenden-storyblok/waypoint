{
  "name": "Do I need a car on the Amalfi Coast?",
  "parent_id": 230624347930176,
  "group_id": "0758d172-8ead-405b-a19c-86d8b15814f1",
  "alternates": [],
  "created_at": "2026-10-15T07:20:06.574Z",
