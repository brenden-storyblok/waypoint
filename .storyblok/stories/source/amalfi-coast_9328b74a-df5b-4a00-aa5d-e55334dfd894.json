  "content": {
    "_uid": "382ab9d9-9790-4758-8ae6-02867e093c53",
    "name": "Amalfi Coast",
    "usps": [
      {
        "_uid": "5b0d6a1e-2c43-4f0e-9a51-0c7e1f3b8a01",
        "text": "A cliff trail links Bomerano and Nocelle high above the sea.",
        "title": "The Path of the Gods",
        "component": "usp_item"
      },
      {
        "_uid": "8c4e2f77-31b5-4d6a-b0e2-6a9d54c1e702",
        "text": "Villa Rufolo and Villa Cimbrone look down on the coast from the hills above Amalfi.",
        "title": "Ravello's garden terraces",
        "component": "usp_item"
      },
      {
        "_uid": "d17a93b5-6e08-4c2f-8f14-3be0a5d27c03",
        "text": "Seasonal boats connect Amalfi, Positano and Salerno and skip the coast road.",
        "title": "Ferries between towns",
        "component": "usp_item"
      },
      {
        "_uid": "e92f40c8-7a15-4b3d-a6c9-12d8f0b45e04",
        "text": "Terraced groves grow the lemons that go into the local limoncello.",
        "title": "Lemons and limoncello",
        "component": "usp_item"
      }
    ],
