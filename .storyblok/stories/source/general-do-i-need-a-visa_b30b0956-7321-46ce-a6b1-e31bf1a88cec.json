{
  "name": "Do I need a visa for these destinations?",
  "parent_id": 230624347930176,
  "group_id": "56ad0ce7-460e-4fbe-8ce8-32598481a78e",
  "alternates": [],
  "created_at": "2026-10-15T07:15:48.256Z",
  "deleted_at": null,
  "sort_by_date": null,
  "tag_list": [],
  "updated_at": "2026-11-10T21:06:46.417Z",
  "published_at": "2026-11-10T21:06:46.392Z",
  "id": 230846252092014,
  "uuid": "b30b0956-7321-46ce-a6b1-e31bf1a88cec",
  "is_folder": false,
  "content": {
    "_uid": "d4a7fab5-8e62-4f4d-8b93-4c5eadbf3a44",
    "answer": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "All six destinations are in the Schengen Area. Entry rules depend on your citizenship.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Check your own government's official travel advice before you book. Rules can change.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "question": "Do I need a visa for these destinations?",
    "component": "faq_item",
    "answer__i18n__de": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Alle sechs Reiseziele liegen im Schengen-Raum. Die Einreisebestimmungen hängen von deiner Staatsangehörigkeit ab.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Prüfe vor der Buchung die offiziellen Reisehinweise deiner eigenen Regierung. Die Regeln können sich ändern.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "answer__i18n__es": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Los seis destinos están en el espacio Schengen. Las normas de entrada dependen de tu nacionalidad.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Consulta las recomendaciones oficiales de viaje de tu propio gobierno antes de reservar. Las normas pueden cambiar.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "answer__i18n__fr": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Les six destinations se trouvent dans l'espace Schengen. Les conditions d'entrée dépendent de votre nationalité.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Consultez les conseils officiels aux voyageurs de votre propre gouvernement avant de réserver. Les règles peuvent changer.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "question__i18n__de": "Brauche ich für diese Reiseziele ein Visum?",
    "question__i18n__es": "¿Necesito visado para estos destinos?",
    "question__i18n__fr": "Ai-je besoin d'un visa pour ces destinations ?"
  },
