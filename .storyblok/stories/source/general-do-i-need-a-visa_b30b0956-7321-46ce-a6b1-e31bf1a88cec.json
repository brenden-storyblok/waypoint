        {
          "type": "paragraph",
          "content": [
            {
              "text": "All six destinations are in the Schengen Area. Entry rules depend on your citizenship.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Check your own government's official travel advice before you book. Rules can change.",
              "type": "text"
            }
          ]
        }
      ]
