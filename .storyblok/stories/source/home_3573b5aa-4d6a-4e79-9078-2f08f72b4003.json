          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Every destination on Waypoint is a place our editors have visited in more than one season. We write about what we would tell a friend: when to go, where to stay and what to skip.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "We add a new destination only after it has earned a second trip.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        "headline": "How we pick",
        "component": "text_block"
