    "body": [
      {
        "_uid": "724e87e7-06b6-43a9-8175-c2637ccc69e9",
        "component": "destination_hero"
      },
      {
        "_uid": "3039ead5-4cf5-4463-88ec-7b3d42e2c358",
        "headline": "Why New Orleans",
        "component": "destination_usps"
      },
      {
        "_uid": "4e1dc357-61cd-46d0-9569-fa29e72db121",
        "headline": "About New Orleans",
        "component": "destination_bio"
      },
      {
        "_uid": "b195439a-5458-477e-bac6-a0a7699fbbb6",
        "headline": "New Orleans in pictures",
        "component": "destination_gallery"
      },
      {
        "_uid": "1053a5c5-d60a-4a2c-b82f-a7a5b5fcec0c",
        "text": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "The RTA runs the buses, the St. Charles, Canal and Riverfront streetcars, and the ferries across the river. Pay with the Le Pass app or exact cash; a bus or streetcar ride costs $1.25.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "A taxi from Louis Armstrong airport to the French Quarter takes about 25 minutes.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "The St. Charles streetcar from Canal Street to Audubon Park takes about 40 minutes.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "The French Quarter runs 13 blocks from Canal Street to Esplanade Avenue.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "headline": "Getting around",
        "component": "text_block"
      }
    ],
    "component": "destination_page",
    "destination": "0c309231-0cb6-4178-9e07-1c7d8b82133d"
