  "content": {
    "_uid": "037b15be-6310-4843-9561-ea9cc54cd11d",
    "name": "Yellowstone",
    "usps": [
      {
        "_uid": "58c4d754-1db4-4eb3-8008-0f25d73c7ca1",
        "text": "The park holds about 500 active geysers, from Old Faithful to the rarely erupting Steamboat.",
        "title": "Half the world's geysers",
        "component": "usp_item"
      },
      {
        "_uid": "eed89879-195c-4875-ab8e-60ba75259c05",
        "text": "The largest hot spring in the United States is about 110 metres across, ringed in orange and yellow microbial mats.",
        "title": "Grand Prismatic Spring",
        "component": "usp_item"
      },
      {
        "_uid": "ad41b139-89f7-4013-98c3-c2d97612d287",
        "text": "Yellowstone is the only place in the United States where bison have lived continuously since prehistoric times.",
        "title": "Wild bison herds",
        "component": "usp_item"
      },
      {
        "_uid": "e4a0461d-0930-4c73-b2fc-3c898fbbc5e4",
        "text": "Wolves reintroduced in 1995 roam the Lamar Valley, best watched at dawn with a spotting scope.",
        "title": "Wolves in the Lamar Valley",
        "component": "usp_item"
      }
    ],
    "region": "Wyoming",
    "country": "united-states",
