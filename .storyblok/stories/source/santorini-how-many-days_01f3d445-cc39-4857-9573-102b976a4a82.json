        {
          "type": "paragraph",
          "content": [
            {
              "text": "Three days cover Fira, Oia, a beach and a winery.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Add a fourth day for Akrotiri and a boat trip on the caldera.",
              "type": "text"
            }
          ]
        }
      ]
