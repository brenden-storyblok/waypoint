{
  "name": "How many days do I need in Santorini?",
  "parent_id": 230624347930176,
  "group_id": "9857e1dc-e143-4fc2-b962-ad05aa77a949",
  "alternates": [],
  "created_at": "2026-10-15T07:17:28.200Z",
  "deleted_at": null,
  "sort_by_date": null,
  "tag_list": [],
  "updated_at": "2026-11-10T20:57:04.186Z",
  "published_at": "2026-11-10T20:57:04.157Z",
  "id": 230846661450365,
  "uuid": "01f3d445-cc39-4857-9573-102b976a4a82",
  "is_folder": false,
  "content": {
    "_uid": "6f1c1c0e-3b0a-4d57-9a54-0a1d3b7f7a03",
    "answer": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Three days cover Fira, Oia, a beach and a winery.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Add a fourth day for Akrotiri and a boat trip on the caldera.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "question": "How many days do I need?",
    "component": "faq_item",
    "answer__i18n__de": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Drei Tage reichen für Fira, Oia, einen Strand und ein Weingut.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Mit einem vierten Tag bleibt Zeit für Akrotiri und eine Bootsfahrt auf der Caldera.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "answer__i18n__es": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Tres días bastan para Fira, Oia, una playa y una bodega.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Añade un cuarto día para Akrotiri y una excursión en barco por la caldera.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "answer__i18n__fr": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Trois jours suffisent pour Fira, Oia, une plage et un domaine viticole.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Ajoutez un quatrième jour pour Akrotiri et une excursion en bateau sur la caldeira.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "question__i18n__de": "Wie viele Tage brauche ich?",
    "question__i18n__es": "¿Cuántos días necesito?",
    "question__i18n__fr": "Combien de jours me faut-il ?"
  },
