        "intro": "An editorial travel guide to places worth a second trip.",
        "headline": "About Waypoint",
        "component": "hero"
      },
      {
        "_uid": "2c0c4883-882d-4292-9a41-5a07265b9764",
        "text": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Waypoint is an editorial guide. Our editors describe each destination once, with what a traveller needs to plan a visit: when to go, where to stay and how to get around.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "We do not sell trips. You plan and book with whoever you choose.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        "headline": "Who we are",
        "component": "text_block"
      },
      {
        "_uid": "a1bd5df7-ba08-44c7-80bf-348d6fcf3c8b",
        "body": [
          {
            "_uid": "72c43ed6-dee6-4bcc-a891-07c8e1a6b8e7",
            "link": {
              "id": "f09756a9-ca01-4082-b9de-fd7b21256a9d",
              "linktype": "story",
              "fieldtype": "multilink",
              "cached_url": "inspiration"
            },
            "label": "Get inspired",
            "variant": "primary",
            "component": "button"
          }
        ],
        "padding": "compact",
        "headline": "Not sure where to go?",
        "component": "section",
        "background": "accent",
        "headline_position": "start"
      },
      {
        "_uid": "9dd62064-f365-49cb-a2fc-f14497f94d2a",
        "text": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Our editors pick places they have visited in more than one season. We add a destination only after it has earned a second trip.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        "headline": "How we choose destinations",
        "component": "text_block"
      },
      {
        "_uid": "b0a6ece3-a4a3-4faf-91b4-6ff19cb91d3a",
        "text": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Waypoint marks any partner link on the page, so you can see it before you click.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        "headline": "How we stay independent",
        "component": "text_block"
      },
