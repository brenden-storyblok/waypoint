  "updated_at": "2026-10-15T08:00:36.977Z",
  "published_at": "2026-10-15T08:00:36.161Z",
  "id": 230846656809596,
  "uuid": "39e71b69-95dd-48a3-9035-273321b75cff",
  "is_folder": false,
  "content": {
    "_uid": "6f1c1c0e-3b0a-4d57-9a54-0a1d3b7f7a02",
    "answer": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Fly or take a ferry. Santorini airport sits near Fira and has frequent flights from Athens, which take about 45 minutes.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Ferries leave Piraeus, the port of Athens, and also connect from other Cyclades islands. Crossings from Piraeus take roughly 5 to 8 hours.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "question": "How do I get there?",
    "component": "faq_item"
  },
