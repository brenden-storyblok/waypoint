{
  "name": "How do I get to Santorini?",
  "parent_id": 230624347930176,
  "group_id": "49507412-9fd5-4e87-9570-26df678b4eb9",
  "alternates": [],
  "created_at": "2026-10-15T07:17:27.065Z",
