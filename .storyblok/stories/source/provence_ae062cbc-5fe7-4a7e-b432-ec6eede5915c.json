  "content": {
    "_uid": "bc6f4da7-ce46-4426-8576-cfc5d4c06874",
    "name": "Provence",
    "usps": [
      {
        "_uid": "5b0a6e0e-8d57-4c1e-9a7b-1a2f3c4d5e01",
        "text": "Fields on the Valensole plateau and near Sénanque Abbey turn purple from late June.",
        "title": "Lavender in July",
        "component": "usp_item"
      },
      {
        "_uid": "5b0a6e0e-8d57-4c1e-9a7b-1a2f3c4d5e02",
        "text": "Gordes and Roussillon sit on ridges, with walls of pale stone or ochre.",
        "title": "Hill villages of the Luberon",
        "component": "usp_item"
      },
      {
        "_uid": "5b0a6e0e-8d57-4c1e-9a7b-1a2f3c4d5e03",
        "text": "Aix-en-Provence fills its squares with stalls of olives, cheese and fruit.",
        "title": "Markets for every meal",
        "component": "usp_item"
      },
      {
        "_uid": "5b0a6e0e-8d57-4c1e-9a7b-1a2f3c4d5e04",
        "text": "Dry rosé from nearby vineyards is the usual pour on a shaded terrace.",
        "title": "Rosé with lunch",
        "component": "usp_item"
      }
    ],
    "region": "Provence-Alpes-Côte d'Azur",
