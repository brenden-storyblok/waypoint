  "content": {
    "_uid": "1886508d-1aa4-48ed-a2ec-ff099b69a3ad",
    "name": "Chiang Mai",
    "usps": [
      {
        "_uid": "f03232ea-83d0-4b1f-a603-3e50602bca84",
        "text": "A naga staircase of more than 300 steps climbs to the gold chedi of Wat Phra That Doi Suthep.",
        "title": "Temple on the mountain",
        "component": "usp_item"
      },
      {
        "_uid": "50bd98d1-d37e-4a09-bf1f-c0210ca1efbc",
        "text": "Wat Chiang Man, inside the moat, dates from the city's founding in the 1290s.",
        "title": "The old Lanna capital",
        "component": "usp_item"
      },
      {
        "_uid": "a7f7fb3f-9733-40f0-a51c-6b35b46ad359",
        "text": "The north's curry noodle soup comes topped with crisp fried noodles, pickled mustard greens and lime.",
        "title": "A bowl of khao soi",
        "component": "usp_item"
      },
      {
        "_uid": "15ac9cdc-14d2-4a01-af62-04f1a11f2dbb",
        "text": "Every Sunday evening, Ratchadamnoen Road closes to traffic for a market that runs from Tha Phae Gate.",
        "title": "Sunday Walking Street",
        "component": "usp_item"
      }
    ],
    "region": "Northern Thailand",
    "country": "thailand",
