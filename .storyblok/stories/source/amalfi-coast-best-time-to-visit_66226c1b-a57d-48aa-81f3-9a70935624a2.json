  "id": 230847314696893,
  "uuid": "66226c1b-a57d-48aa-81f3-9a70935624a2",
  "is_folder": false,
  "content": {
    "_uid": "3a4961fe-9cdd-4a80-b976-da071c927d5f",
    "answer": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "May, June and September bring warm days and swimmable water with fewer crowds.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "July and August are the busiest months. Ferries run on a seasonal schedule, and some hotels and restaurants close in winter.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "question": "When is the best time to visit?",
    "component": "faq_item"
  },
