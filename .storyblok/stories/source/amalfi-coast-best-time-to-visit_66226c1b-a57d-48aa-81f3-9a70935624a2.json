{
  "name": "When is the best time to visit the Amalfi Coast?",
  "parent_id": 230624347930176,
  "group_id": "51fea476-1ecf-440d-a148-639d173c840b",
  "alternates": [],
  "created_at": "2026-10-15T07:20:07.685Z",
  "deleted_at": null,
  "sort_by_date": null,
  "tag_list": [],
  "updated_at": "2026-11-10T20:55:50.258Z",
  "published_at": "2026-11-10T20:55:50.225Z",
  "id": 230847314696893,
  "uuid": "66226c1b-a57d-48aa-81f3-9a70935624a2",
  "is_folder": false,
  "content": {
    "_uid": "3a4961fe-9cdd-4a80-b976-da071c927d5f",
    "answer": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "May, June and September bring warm days and swimmable water with fewer crowds.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "July and August are the busiest months. Ferries run on a seasonal schedule, and some hotels and restaurants close in winter.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "question": "When is the best time to visit?",
    "component": "faq_item",
    "answer__i18n__de": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Mai, Juni und September bringen warme Tage und badetaugliches Wasser bei weniger Andrang.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Juli und August sind die geschäftigsten Monate. Die Fähren verkehren nach einem saisonalen Fahrplan, und einige Hotels und Restaurants schließen im Winter.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "answer__i18n__es": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Mayo, junio y septiembre traen días cálidos y agua apta para el baño, con menos aglomeraciones.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Julio y agosto son los meses con más gente. Los ferris siguen un horario estacional y algunos hoteles y restaurantes cierran en invierno.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "answer__i18n__fr": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Mai, juin et septembre offrent des journées chaudes et une eau propice à la baignade, avec moins de monde.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Juillet et août sont les mois les plus fréquentés. Les ferries suivent un horaire saisonnier, et certains hôtels et restaurants ferment en hiver.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "question__i18n__de": "Wann ist die beste Reisezeit?",
    "question__i18n__es": "¿Cuál es la mejor época para visitar?",
    "question__i18n__fr": "Quelle est la meilleure période pour y aller ?"
  },
