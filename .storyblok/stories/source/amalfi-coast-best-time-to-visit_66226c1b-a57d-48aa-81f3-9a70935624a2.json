{
  "name": "When is the best time to visit the Amalfi Coast?",
  "parent_id": 230624347930176,
  "group_id": "51fea476-1ecf-440d-a148-639d173c840b",
  "alternates": [],
  "created_at": "2026-10-15T07:20:07.685Z",
