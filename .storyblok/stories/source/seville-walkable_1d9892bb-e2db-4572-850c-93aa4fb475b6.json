{
  "name": "Is Seville walkable?",
  "parent_id": 230624347930176,
  "group_id": "869855f1-b6a3-41b2-95b2-2124fe10404c",
  "alternates": [],
  "created_at": "2026-10-15T07:20:52.289Z",
