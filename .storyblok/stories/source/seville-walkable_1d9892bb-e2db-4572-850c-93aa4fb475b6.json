  "id": 230847497403086,
  "uuid": "1d9892bb-e2db-4572-850c-93aa4fb475b6",
  "is_folder": false,
  "content": {
    "_uid": "6a1c0b52-3f1e-4d8e-9a77-1b2c3d4e5f02",
    "answer": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Yes. The old centre is compact and flat. The Cathedral, the Real Alcázar and the Santa Cruz quarter sit within a short walk of each other.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Use a bus, tram or Sevici bike for Plaza de España and for longer trips in the heat.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "question": "Is it walkable?",
    "component": "faq_item"
  },
