  "content": {
    "_uid": "487a1e58-fe8a-49d6-9aeb-b323f8c57fb3",
    "name": "Ha Long Bay",
    "usps": [
      {
        "_uid": "c8665554-b52e-4f6d-a95c-6a099ed38869",
        "text": "Overnight junks anchor among the karsts, so you wake to the islands before the day boats sail from Tuan Chau.",
        "title": "A night on the bay",
        "component": "usp_item"
      },
      {
        "_uid": "216a744d-8ce7-4aa2-82a3-e18406a456b1",
        "text": "Sung Sot, the Surprise Cave, opens into chambers of stalactites high inside an island.",
        "title": "Caves inside the islands",
        "component": "usp_item"
      },
      {
        "_uid": "15f8647a-9fca-4641-a9c9-69a516cb4672",
        "text": "Kayaks slip under low rock arches into enclosed lagoons that larger boats cannot reach.",
        "title": "Paddle through the arches",
        "component": "usp_item"
      },
      {
        "_uid": "3a8ba332-1c78-4257-9396-2135f75b30cc",
        "text": "South of Ha Long, Lan Ha Bay off Cat Ba Island has the same karsts with fewer boats.",
        "title": "Lan Ha Bay next door",
        "component": "usp_item"
      }
    ],
    "region": "Quang Ninh",
