  "content": {
    "_uid": "1403cba2-2aad-4371-9a24-54b0687a93bb",
    "name": "Lisbon",
    "usps": [
      {
        "_uid": "733fe7a4-d409-47f0-9d75-bbb8f53fa925",
        "text": "Miradouros like Senhora do Monte and São Pedro de Alcântara look over red roofs to the river.",
        "title": "A viewpoint on every hill",
        "component": "usp_item"
      },
      {
        "_uid": "4685983e-71b5-486b-aa77-bef9f7548080",
        "text": "The 1930s Remodelado trams climb lanes too narrow for buses.",
        "title": "Tram 28 through Alfama",
        "component": "usp_item"
      },
      {
        "_uid": "c1aca3d2-b114-4039-8e80-78d5ba2fc350",
        "text": "Belém bakeries have served the custard tart since 1837.",
        "title": "Pastéis de nata, fresh",
        "component": "usp_item"
      },
      {
        "_uid": "75e6c992-7153-4a03-a08e-588109460343",
        "text": "Cascais and Estoril sit 40 minutes west on the coastal line.",
        "title": "Beaches by train",
        "component": "usp_item"
      }
    ],
    "region": "Lisbon Region",
