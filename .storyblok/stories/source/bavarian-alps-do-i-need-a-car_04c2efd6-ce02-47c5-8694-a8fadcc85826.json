{
  "name": "Do I need a car in the Bavarian Alps?",
  "parent_id": 230624347930176,
  "group_id": "0322d98b-ff95-40f5-a291-10aa3b2fdff1",
  "alternates": [],
  "created_at": "2026-10-15T07:18:04.913Z",
  "deleted_at": null,
  "sort_by_date": null,
  "tag_list": [],
  "updated_at": "2026-10-15T08:00:37.138Z",
  "published_at": "2026-10-15T08:00:36.161Z",
  "id": 230846811839140,
  "uuid": "04c2efd6-ce02-47c5-8694-a8fadcc85826",
  "is_folder": false,
  "content": {
    "_uid": "6f1c2a0e-3b7d-4c55-9a11-2d4e8b7a0c02",
    "answer": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "No. Regional trains run from Munich to Garmisch-Partenkirchen and to Berchtesgaden. RVO buses and cable cars cover most trailheads and lakes.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "A car helps only for remote side valleys and early starts.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "question": "Do I need a car?",
    "component": "faq_item"
  },
