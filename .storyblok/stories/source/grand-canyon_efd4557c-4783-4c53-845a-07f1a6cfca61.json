        "component": "destination_hero"
      },
      {
        "_uid": "d8d3fc75-ae69-4d19-8c65-a56daeea8fd0",
        "headline": "Why Grand Canyon",
        "component": "destination_usps"
      },
      {
        "_uid": "f6d051d3-883f-44a9-95be-ff28882b11ac",
        "headline": "About Grand Canyon",
        "component": "destination_bio"
      },
      {
        "_uid": "28933b88-f307-4ae3-84a9-3eb4b94584ae",
        "headline": "Grand Canyon in pictures",
        "component": "destination_gallery"
      },
      {
        "_uid": "d8d1809b-a4e1-4a79-9693-9e2c36849244",
        "text": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Free shuttle buses run four routes on the South Rim. Hermit Road is closed to private cars from March 1 to November 30, so the Red Route shuttle takes you to its viewpoints.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Flagstaff to the South Rim is about 130 km, a 90-minute drive.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Las Vegas to the South Rim is about 450 km, roughly 4.5 hours by car.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "South Rim to North Rim is 346 km by road, about 4.5 hours.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "headline": "Getting around",
        "component": "text_block"
      }
    ],
    "component": "destination_page",
    "destination": "33ab30a8-3cb9-4780-a391-16576e35a50d"
