      },
      {
        "_uid": "2b7e4d63-9e1f-4c8b-8d25-6f3c8b1e7a22",
        "headline": "Why the Amalfi Coast",
        "component": "destination_usps"
      },
      {
        "_uid": "3c8f5e74-af20-4d9c-9e36-7a4d9c2f8b33",
        "headline": "About the Amalfi Coast",
        "component": "destination_bio"
      },
      {
        "_uid": "4d9a6f85-b031-4ead-af47-8b5ead3a9c44",
        "headline": "The Amalfi Coast in pictures",
        "component": "destination_gallery"
      },
      {
        "_uid": "5eab7096-c142-4fbe-b058-9c6fbe4bad55",
        "text": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "The coast road is slow and crowded in summer, so most visitors travel by bus, boat or on foot.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Ferries link the main towns on a seasonal schedule.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "SITA buses run along the coast road between the towns.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "The Path of the Gods is a walking trail above the sea.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "headline": "Getting around",
        "component": "text_block"
      },
      {
