  "id": 230847423937218,
  "uuid": "438a2c52-1f47-4a99-8ef2-1f74666dfba3",
  "is_folder": false,
  "content": {
    "_uid": "84e4bd4e-4b79-45f3-a6de-d1bc311f1c23",
    "body": [
      {
        "_uid": "1a6f3c52-8d0e-4b7a-9c14-5e2b7a0d6f11",
        "component": "destination_hero"
      },
      {
        "_uid": "2b7e4d63-9e1f-4c8b-8d25-6f3c8b1e7a22",
        "headline": "Why the Amalfi Coast",
        "component": "destination_usps",
        "headline__i18n__de": "Warum die Amalfi-Küste",
        "headline__i18n__es": "Por qué la Costa Amalfitana",
        "headline__i18n__fr": "Pourquoi la côte amalfitaine"
      },
      {
        "_uid": "3c8f5e74-af20-4d9c-9e36-7a4d9c2f8b33",
        "headline": "About the Amalfi Coast",
        "component": "destination_bio",
        "headline__i18n__de": "Über die Amalfi-Küste",
        "headline__i18n__es": "Sobre la Costa Amalfitana",
        "headline__i18n__fr": "À propos de la côte amalfitaine"
      },
      {
        "_uid": "4d9a6f85-b031-4ead-af47-8b5ead3a9c44",
        "headline": "The Amalfi Coast in pictures",
        "component": "destination_gallery",
        "headline__i18n__de": "Die Amalfi-Küste in Bildern",
        "headline__i18n__es": "La Costa Amalfitana en imágenes",
        "headline__i18n__fr": "La côte amalfitaine en images"
      },
      {
        "_uid": "5eab7096-c142-4fbe-b058-9c6fbe4bad55",
        "text": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "The coast road is slow and crowded in summer, so most visitors travel by bus, boat or on foot.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Ferries link the main towns on a seasonal schedule.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "SITA buses run along the coast road between the towns.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "The Path of the Gods is a walking trail above the sea.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "headline": "Getting around",
        "component": "text_block",
        "text__i18n__de": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Die Küstenstraße ist im Sommer langsam und überfüllt, daher reisen die meisten Besucher mit Bus, Boot oder zu Fuß.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Fähren verbinden die wichtigsten Orte nach saisonalem Fahrplan.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "SITA-Busse verkehren auf der Küstenstraße zwischen den Orten.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Der Pfad der Götter ist ein Wanderweg über dem Meer.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "text__i18n__es": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "La carretera de la costa es lenta y está llena de gente en verano, así que la mayoría de los visitantes viajan en autobús, en barco o a pie.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Los ferris conectan las principales localidades con un horario de temporada.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Los autobuses SITA circulan por la carretera de la costa entre las localidades.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "El Sendero de los Dioses es una ruta de senderismo sobre el mar.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "text__i18n__fr": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "La route côtière est lente et encombrée en été, si bien que la plupart des visiteurs voyagent en bus, en bateau ou à pied.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Des ferries relient les principales villes selon un horaire saisonnier.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Les bus SITA circulent sur la route côtière entre les villes.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Le Chemin des Dieux est un sentier de randonnée au-dessus de la mer.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "headline__i18n__de": "Unterwegs",
        "headline__i18n__es": "Cómo moverse",
        "headline__i18n__fr": "Se déplacer"
      },
