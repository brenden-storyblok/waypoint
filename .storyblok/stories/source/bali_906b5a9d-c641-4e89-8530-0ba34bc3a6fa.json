        "component": "destination_hero"
      },
      {
        "_uid": "bfea5bbf-a6e6-4196-94bc-73ae6e9b1d19",
        "headline": "Why Bali",
        "component": "destination_usps"
      },
      {
        "_uid": "57227c6d-0fef-4828-a089-2592331c5c22",
        "headline": "About Bali",
        "component": "destination_bio"
      },
      {
        "_uid": "881e3a1a-f103-44f2-87bd-f36ced389515",
        "headline": "Bali in pictures",
        "component": "destination_gallery"
      },
      {
        "_uid": "d4f069da-deb6-4ac8-aa7f-5b7d85fe0127",
        "text": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Bali has little public transport. Most visitors book cars through the Grab or Gojek apps, or hire a driver for the day. Traffic in the south is slow, so plan short hops.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "A car from Ngurah Rai Airport to Ubud takes about 1 hour 30 minutes.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Fast boats from Sanur to Nusa Penida take 30 to 45 minutes.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Ubud to Tegallalang is about 20 minutes by car or scooter.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "headline": "Getting around",
        "component": "text_block"
      }
    ],
