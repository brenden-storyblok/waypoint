  "content": {
    "_uid": "1be59836-91d8-48bd-b6d9-bed67f81707d",
    "name": "Maui",
    "usps": [
      {
        "_uid": "15318bf7-08ef-426d-bf0c-dab88718de9f",
        "text": "The Haleakalā summit sits at 3,055 metres, and sunrise visits need a park reservation.",
        "title": "Sunrise above the clouds",
        "component": "usp_item"
      },
      {
        "_uid": "99e22e4e-8cbf-41d2-b8b9-6ed71cd2ead7",
        "text": "The Hana Highway crosses 59 bridges on its way along the rainforest coast of East Maui.",
        "title": "The road to Hana",
        "component": "usp_item"
      },
      {
        "_uid": "6d318a36-4507-4617-bfe5-334afc0b8838",
        "text": "Thousands of humpback whales calve each winter in the warm channels between Maui, Lānaʻi and Molokaʻi.",
        "title": "Humpback winter",
        "component": "usp_item"
      },
      {
        "_uid": "aa309ae4-6d09-41ea-9af5-66b3441452c6",
        "text": "Molokini, a crescent-shaped volcanic crater off the south coast, shelters about 250 species of fish.",
        "title": "Snorkel a sunken crater",
        "component": "usp_item"
      }
    ],
    "region": "Hawaii",
