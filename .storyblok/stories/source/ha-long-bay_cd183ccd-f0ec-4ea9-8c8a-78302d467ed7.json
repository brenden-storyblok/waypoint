      {
        "_uid": "dec59e7e-7fb1-4c7f-91c7-7bfdb61a00fa",
        "headline": "Why Ha Long Bay",
        "component": "destination_usps"
      },
      {
        "_uid": "90768ea0-e51c-4200-9fd4-e33b859b9597",
        "headline": "About Ha Long Bay",
        "component": "destination_bio"
      },
      {
        "_uid": "3f303c1c-b589-4c20-b165-54fb9d7862bd",
        "headline": "Ha Long Bay in pictures",
        "component": "destination_gallery"
      },
      {
        "_uid": "71513305-c727-477f-ad5e-8f9f2875133b",
        "text": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Most visitors come from Hanoi by cruise shuttle bus or private car along the expressway. Day boats and overnight junks leave from Tuan Chau and Bai Chay harbours.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Hanoi to Ha Long by expressway takes about 2 hours 30 minutes.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Van Don International Airport is about 50 kilometres from Ha Long city.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Day cruises on the bay run about 4 to 6 hours from the harbour and back.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "headline": "Getting around",
        "component": "text_block"
      }
    ],
