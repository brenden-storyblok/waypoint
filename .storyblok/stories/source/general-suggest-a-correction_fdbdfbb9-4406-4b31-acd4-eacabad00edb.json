        {
          "type": "paragraph",
          "content": [
            {
              "text": "Use the Contact page. Tell us which page and which detail needs a fix.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "question": "How can I suggest a correction?",
    "component": "faq_item",
    "answer__i18n__de": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Nutze die Kontaktseite. Teile uns mit, welche Seite und welches Detail korrigiert werden muss.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "answer__i18n__es": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Usa la página de contacto. Indícanos qué página y qué dato hay que corregir.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "answer__i18n__fr": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Utilisez la page Contact. Indiquez-nous quelle page et quel détail doivent être corrigés.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "question__i18n__de": "Wie kann ich eine Korrektur vorschlagen?",
