{
  "name": "When is the best time to visit Seville?",
  "parent_id": 230624347930176,
  "group_id": "b6b5248f-a9a2-486f-a7b1-3575764ba4bc",
  "alternates": [],
  "created_at": "2026-10-15T07:20:51.095Z",
  "deleted_at": null,
  "sort_by_date": null,
  "tag_list": [],
  "updated_at": "2026-11-10T21:05:17.304Z",
  "published_at": "2026-11-10T21:05:17.277Z",
  "id": 230847492520652,
  "uuid": "a2f0cf8a-368d-41cd-a8dd-a58f63cca57b",
  "is_folder": false,
  "content": {
    "_uid": "6a1c0b52-3f1e-4d8e-9a77-1b2c3d4e5f01",
    "answer": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "March to May and October to November. Days are warm and the streets are comfortable to walk.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "July and August often pass 35°C (95°F). If you come then, plan sightseeing for early morning and evening.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "question": "When is the best time to visit?",
    "component": "faq_item",
    "answer__i18n__de": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "März bis Mai und Oktober bis November. Die Tage sind warm, und die Straßen lassen sich angenehm zu Fuß erkunden.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Im Juli und August werden oft mehr als 35 °C erreicht. Wenn du dann kommst, plane Besichtigungen für den frühen Morgen und den Abend.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "answer__i18n__es": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "De marzo a mayo y de octubre a noviembre. Los días son cálidos y se pasea cómodamente por las calles.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "En julio y agosto se superan a menudo los 35 °C. Si vienes entonces, planifica las visitas para primera hora de la mañana y la tarde-noche.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "answer__i18n__fr": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "De mars à mai et d'octobre à novembre. Les journées sont chaudes et il est agréable de se promener dans les rues.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "En juillet et en août, il dépasse souvent 35 °C. Si vous venez à cette période, prévoyez vos visites tôt le matin et en soirée.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "question__i18n__de": "Wann ist die beste Reisezeit?",
    "question__i18n__es": "¿Cuál es la mejor época para visitar?",
    "question__i18n__fr": "Quelle est la meilleure période pour y aller ?"
  },
