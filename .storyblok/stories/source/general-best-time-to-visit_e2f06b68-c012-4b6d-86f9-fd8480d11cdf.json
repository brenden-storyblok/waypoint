{
  "name": "When is the best time to visit southern Europe?",
  "parent_id": 230624347930176,
  "group_id": "5a7ae565-9cb8-4bec-a353-83a7054a6036",
  "alternates": [],
  "created_at": "2026-10-15T07:15:49.438Z",
  "deleted_at": null,
  "sort_by_date": null,
  "tag_list": [],
  "updated_at": "2026-11-10T20:57:39.482Z",
  "published_at": "2026-11-10T20:57:39.433Z",
  "id": 230846256933488,
  "uuid": "e2f06b68-c012-4b6d-86f9-fd8480d11cdf",
  "is_folder": false,
  "content": {
    "_uid": "e5b8abc6-9f73-4a5e-9ca4-5d6fbfca4b55",
    "answer": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Spring and autumn are the best seasons. The weather is mild and the crowds are smaller.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Summer is hot and busy.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "question": "When is the best time to visit southern Europe?",
    "component": "faq_item",
    "answer__i18n__de": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Frühling und Herbst sind die besten Jahreszeiten. Das Wetter ist mild, und es ist weniger los.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Der Sommer ist heiß und voll.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "answer__i18n__es": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "La primavera y el otoño son las mejores estaciones. El tiempo es suave y hay menos gente.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "El verano es caluroso y concurrido.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "answer__i18n__fr": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Le printemps et l'automne sont les meilleures saisons. Le temps est doux et il y a moins de monde.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "L'été est chaud et très fréquenté.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "question__i18n__de": "Wann ist die beste Reisezeit für Südeuropa?",
    "question__i18n__es": "¿Cuál es la mejor época para visitar el sur de Europa?",
    "question__i18n__fr": "Quelle est la meilleure période pour visiter le sud de l'Europe ?"
  },
