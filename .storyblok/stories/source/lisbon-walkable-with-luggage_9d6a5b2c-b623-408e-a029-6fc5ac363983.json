{
  "name": "Is Lisbon walkable with luggage?",
  "parent_id": 230624347930176,
  "group_id": "1411c680-d708-4857-ad27-d811f621c59e",
  "alternates": [],
  "created_at": "2026-10-14T16:22:01.233Z",
  "deleted_at": null,
  "sort_by_date": null,
  "tag_list": [],
  "updated_at": "2026-11-10T21:06:59.680Z",
  "published_at": "2026-11-10T21:06:59.652Z",
  "id": 230626595792071,
  "uuid": "9d6a5b2c-b623-408e-a029-6fc5ac363983",
  "is_folder": false,
  "content": {
    "_uid": "e6869b3b-73eb-40c1-8b6e-dd6c567ce4fa",
    "answer": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "The hills and cobbles make it hard. Take a taxi or the metro to your door.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "question": "Is Lisbon walkable with luggage?",
    "component": "faq_item",
    "answer__i18n__de": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Die Hügel und das Kopfsteinpflaster machen es schwierig. Nimm ein Taxi oder die U-Bahn bis vor die Haustür.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "answer__i18n__es": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Las cuestas y los adoquines lo hacen difícil. Toma un taxi o el metro hasta la puerta de tu alojamiento.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "answer__i18n__fr": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Les collines et les pavés rendent cela difficile. Prenez un taxi ou le métro jusqu'à votre porte.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "question__i18n__de": "Ist Lissabon mit Gepäck gut zu Fuß zu bewältigen?",
    "question__i18n__es": "¿Se puede recorrer Lisboa a pie con equipaje?",
    "question__i18n__fr": "Lisbonne est-elle praticable à pied avec des bagages ?"
  },
