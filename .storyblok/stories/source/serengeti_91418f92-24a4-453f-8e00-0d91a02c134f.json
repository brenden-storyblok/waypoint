  "content": {
    "_uid": "251d1412-f82c-4833-b1cd-1070282e355e",
    "name": "Serengeti",
    "usps": [
      {
        "_uid": "c83fcd22-c421-4bc4-a45f-25afa4f0e8a0",
        "text": "Around 1.5 million wildebeest circle between the Serengeti and Kenya's Masai Mara each year.",
        "title": "The Great Migration",
        "component": "usp_item"
      },
      {
        "_uid": "c1c0d0be-f35a-4e0e-9d71-25ce88b6d6d2",
        "text": "The herds drop most of their calves on the short-grass plains of the south in January and February.",
        "title": "Calving on the southern plains",
        "component": "usp_item"
      },
      {
        "_uid": "af747a23-ab0d-451c-8f59-a3b0ac82b3bd",
        "text": "Hot-air balloon flights lift off before sunrise near Seronera and end with breakfast in the bush.",
        "title": "Balloons at dawn",
        "component": "usp_item"
      },
      {
        "_uid": "7fd35cfe-05ab-4e85-9494-453ed56f7cdd",
        "text": "Granite outcrops such as the Moru Kopjes give lions and leopards a lookout above the grass.",
        "title": "Big cats on the kopjes",
        "component": "usp_item"
      }
    ],
    "region": "Mara and Simiyu",
    "country": "tanzania",
