        "component": "destination_hero"
      },
      {
        "_uid": "6735ff9f-cae3-47da-bf2b-38c1c5c741e7",
        "headline": "Why San Francisco",
        "component": "destination_usps"
      },
      {
        "_uid": "2cd94b4a-3dfd-46dc-a193-62748a6ae8ed",
        "headline": "About San Francisco",
        "component": "destination_bio"
      },
      {
        "_uid": "1d95e61c-5665-45ea-9be9-e0d073e65fd0",
        "headline": "San Francisco in pictures",
        "component": "destination_gallery"
      },
      {
        "_uid": "d0c95288-6492-4fdf-bf91-2eeb438afae2",
        "text": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Muni runs the buses, light rail, historic streetcars and cable cars, and BART links the city to the airport and the East Bay. A Clipper card or phone pays for both; a cable car ride costs $8.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "BART from SFO to Powell Street takes about 30 minutes.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "The ferry from Pier 33 to Alcatraz takes about 15 minutes.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Walking across the Golden Gate Bridge and back is about 5.4 km.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "headline": "Getting around",
        "component": "text_block"
      }
    ],
    "component": "destination_page",
    "destination": "cb725689-5cab-4857-9e75-f8701dd452f3"
