  "id": 230952967237305,
  "uuid": "17ff20b9-213c-4cf5-9fdf-d5756a1375d9",
  "is_folder": false,
  "content": {
    "_uid": "59696172-0ef9-4fa6-9619-1eac94b159e0",
    "body": [
      {
        "_uid": "169779a9-9b86-401b-b043-ad9216e57935",
        "component": "destination_hero"
      },
      {
        "_uid": "6735ff9f-cae3-47da-bf2b-38c1c5c741e7",
        "headline": "Why San Francisco",
        "component": "destination_usps",
        "headline__i18n__de": "Warum San Francisco",
        "headline__i18n__es": "Por qué San Francisco",
        "headline__i18n__fr": "Pourquoi San Francisco"
      },
      {
        "_uid": "2cd94b4a-3dfd-46dc-a193-62748a6ae8ed",
        "headline": "About San Francisco",
        "component": "destination_bio",
        "headline__i18n__de": "Über San Francisco",
        "headline__i18n__es": "Sobre San Francisco",
        "headline__i18n__fr": "À propos de San Francisco"
      },
      {
        "_uid": "1d95e61c-5665-45ea-9be9-e0d073e65fd0",
        "headline": "San Francisco in pictures",
        "component": "destination_gallery",
        "headline__i18n__de": "San Francisco in Bildern",
        "headline__i18n__es": "San Francisco en imágenes",
        "headline__i18n__fr": "San Francisco en images"
      },
      {
        "_uid": "d0c95288-6492-4fdf-bf91-2eeb438afae2",
        "text": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Muni runs the buses, light rail, historic streetcars and cable cars, and BART links the city to the airport and the East Bay. A Clipper card or phone pays for both; a cable car ride costs $8.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "BART from SFO to Powell Street takes about 30 minutes.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "The ferry from Pier 33 to Alcatraz takes about 15 minutes.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Walking across the Golden Gate Bridge and back is about 5.4 km.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "headline": "Getting around",
        "component": "text_block",
        "text__i18n__de": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Die Muni betreibt Busse, Stadtbahn, historische Straßenbahnen und Cable Cars, und die BART verbindet die Stadt mit dem Flughafen und der East Bay. Beides lässt sich mit einer Clipper Card oder dem Smartphone bezahlen; eine Fahrt mit dem Cable Car kostet 8 $.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Die BART vom SFO zur Powell Street braucht etwa 30 Minuten.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Die Fähre von Pier 33 nach Alcatraz braucht etwa 15 Minuten.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Hin und zurück zu Fuß über die Golden Gate Bridge sind es etwa 5,4 km.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "text__i18n__es": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Muni gestiona los autobuses, el tren ligero, los tranvías históricos y los cable cars, y BART conecta la ciudad con el aeropuerto y East Bay. Se puede pagar ambos con una tarjeta Clipper o con el móvil; un viaje en cable car cuesta 8 $.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "El BART desde SFO hasta Powell Street tarda unos 30 minutos.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "El ferri desde el Pier 33 hasta Alcatraz tarda unos 15 minutos.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Cruzar a pie el puente Golden Gate y volver son unos 5,4 km.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "text__i18n__fr": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "La Muni exploite les bus, le tramway léger, les tramways historiques et les cable cars, et le BART relie la ville à l'aéroport et à l'East Bay. Une carte Clipper ou un téléphone permet de payer les deux ; un trajet en cable car coûte 8 $.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Le BART de SFO à Powell Street met environ 30 minutes.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Le ferry du Pier 33 à Alcatraz met environ 15 minutes.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Traverser le Golden Gate Bridge à pied, aller-retour, représente environ 5,4 km.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "headline__i18n__de": "Unterwegs",
        "headline__i18n__es": "Cómo moverse",
        "headline__i18n__fr": "Se déplacer"
      }
