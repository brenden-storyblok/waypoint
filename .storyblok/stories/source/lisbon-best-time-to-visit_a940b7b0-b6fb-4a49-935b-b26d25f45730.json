{
  "name": "When is the best time to visit Lisbon?",
  "parent_id": 230624347930176,
  "group_id": "99c51c49-62b6-4cee-a5e2-d8c0ddb4cf14",
  "alternates": [],
  "created_at": "2026-10-14T16:21:59.207Z",
  "deleted_at": null,
  "sort_by_date": null,
  "tag_list": [],
  "updated_at": "2026-11-10T20:58:43.831Z",
  "published_at": "2026-11-10T20:58:43.799Z",
  "id": 230626587493573,
  "uuid": "a940b7b0-b6fb-4a49-935b-b26d25f45730",
  "is_folder": false,
  "content": {
    "_uid": "6932ac39-37db-41da-88e8-0fda24b73f74",
    "answer": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "April to June and September to October. Days stay warm, and the queues at Belém and the castle stay short.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "question": "When is the best time to visit Lisbon?",
    "component": "faq_item",
    "answer__i18n__de": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "April bis Juni und September bis Oktober. Die Tage bleiben warm, und die Warteschlangen in Belém und an der Burg bleiben kurz.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "answer__i18n__es": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "De abril a junio y de septiembre a octubre. Los días siguen siendo cálidos y las colas en Belém y en el castillo se mantienen cortas.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "answer__i18n__fr": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "D'avril à juin et de septembre à octobre. Les journées restent chaudes et les files d'attente à Belém et au château restent courtes.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "question__i18n__de": "Wann ist die beste Reisezeit für Lissabon?",
    "question__i18n__es": "¿Cuál es la mejor época para visitar Lisboa?",
    "question__i18n__fr": "Quelle est la meilleure période pour visiter Lisbonne ?"
  },
