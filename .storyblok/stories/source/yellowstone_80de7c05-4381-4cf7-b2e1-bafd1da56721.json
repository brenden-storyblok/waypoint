        "component": "destination_hero"
      },
      {
        "_uid": "34eea7ce-48ed-4fc7-b01d-60c370ed8d49",
        "headline": "Why Yellowstone",
        "component": "destination_usps"
      },
      {
        "_uid": "24f8f7ee-6489-41b5-93b2-72e2dbbe76b1",
        "headline": "About Yellowstone",
        "component": "destination_bio"
      },
      {
        "_uid": "4108e700-a888-4424-93d3-ff2902880dda",
        "headline": "Yellowstone in pictures",
        "component": "destination_gallery"
      },
      {
        "_uid": "22daf93d-3d37-4b79-a79a-890d7b637549",
        "text": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "There is no public transport inside the park, so drive. The Grand Loop Road links the main sights in a figure of eight of about 229 kilometres, and wildlife often stops traffic.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "West Yellowstone to Old Faithful is about 50 kilometres, or roughly 1 hour by car.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Old Faithful to Grand Prismatic Spring is about 15 kilometres, or 20 minutes.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Canyon Village to the Lamar Valley takes about 1 hour 15 minutes over Dunraven Pass.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "headline": "Getting around",
        "component": "text_block"
      }
    ],
    "component": "destination_page",
    "destination": "587a27e4-1102-4b95-a9f2-8c4149098f37"
  },
