{
  "name": "How many days do I need in Seville?",
  "parent_id": 230624347930176,
  "group_id": "108fc2c9-a96d-4cd3-bc56-cba2cf81c1d9",
  "alternates": [],
  "created_at": "2026-10-15T07:20:53.452Z",
  "deleted_at": null,
  "sort_by_date": null,
  "tag_list": [],
  "updated_at": "2026-11-10T20:55:12.462Z",
  "published_at": "2026-11-10T20:55:12.433Z",
  "id": 230847502174928,
  "uuid": "d1a627e0-ce86-4640-ad8e-cb7f30317ba0",
  "is_folder": false,
  "content": {
    "_uid": "6a1c0b52-3f1e-4d8e-9a77-1b2c3d4e5f03",
    "answer": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Two full days cover the Cathedral, the Real Alcázar and Plaza de España.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Three days leave time for Triana, Las Setas and a flamenco show.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "question": "How many days do I need?",
    "component": "faq_item",
    "answer__i18n__de": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Zwei volle Tage reichen für die Kathedrale, den Real Alcázar und die Plaza de España.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Mit drei Tagen bleibt Zeit für Triana, Las Setas und eine Flamenco-Show.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "answer__i18n__es": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Dos días completos bastan para la Catedral, el Real Alcázar y la Plaza de España.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Con tres días hay tiempo para Triana, las Setas y un espectáculo de flamenco.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "answer__i18n__fr": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Deux jours complets suffisent pour la cathédrale, le Real Alcázar et la Plaza de España.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Avec trois jours, vous aurez le temps de découvrir Triana, Las Setas et un spectacle de flamenco.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "question__i18n__de": "Wie viele Tage brauche ich?",
    "question__i18n__es": "¿Cuántos días necesito?",
    "question__i18n__fr": "Combien de jours me faut-il ?"
  },
