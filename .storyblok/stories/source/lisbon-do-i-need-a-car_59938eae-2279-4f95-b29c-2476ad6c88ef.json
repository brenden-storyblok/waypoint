{
  "name": "Do I need a car in Lisbon?",
  "parent_id": 230624347930176,
  "group_id": "f51c935e-83a3-497c-8377-fd455caccd4a",
  "alternates": [],
  "created_at": "2026-10-14T16:22:00.327Z",
  "deleted_at": null,
  "sort_by_date": null,
  "tag_list": [],
  "updated_at": "2026-11-10T20:58:43.058Z",
  "published_at": "2026-11-10T20:58:43.036Z",
  "id": 230626592093382,
  "uuid": "59938eae-2279-4f95-b29c-2476ad6c88ef",
  "is_folder": false,
  "content": {
    "_uid": "b0e717e1-86c6-47ca-86a4-81470b77ccc6",
    "answer": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "No. The metro, trams and suburban trains reach everything in the city and along the coast.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "question": "Do I need a car?",
    "component": "faq_item",
    "answer__i18n__de": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Nein. U-Bahn, Straßenbahnen und Vorortzüge erreichen alles in der Stadt und entlang der Küste.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "answer__i18n__es": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "No. El metro, los tranvías y los trenes de cercanías llegan a todo en la ciudad y a lo largo de la costa.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "answer__i18n__fr": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Non. Le métro, les tramways et les trains de banlieue desservent tout en ville et le long de la côte.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "question__i18n__de": "Brauche ich ein Auto?",
    "question__i18n__es": "¿Necesito coche?",
    "question__i18n__fr": "Ai-je besoin d'une voiture ?"
  },
