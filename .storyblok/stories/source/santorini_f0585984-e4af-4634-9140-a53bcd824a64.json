  "id": 230846815120038,
  "uuid": "f0585984-e4af-4634-9140-a53bcd824a64",
  "is_folder": false,
  "content": {
    "_uid": "7a2d9c10-5e0b-4c11-8a31-1b0f6d2e4d00",
    "body": [
      {
        "_uid": "7a2d9c10-5e0b-4c11-8a31-1b0f6d2e4d01",
        "component": "destination_hero"
      },
      {
        "_uid": "7a2d9c10-5e0b-4c11-8a31-1b0f6d2e4d02",
        "headline": "Why Santorini",
        "component": "destination_usps",
        "headline__i18n__de": "Warum Santorin",
        "headline__i18n__es": "Por qué Santorini",
        "headline__i18n__fr": "Pourquoi Santorin"
      },
      {
        "_uid": "7a2d9c10-5e0b-4c11-8a31-1b0f6d2e4d03",
        "headline": "About Santorini",
        "component": "destination_bio",
        "headline__i18n__de": "Über Santorin",
        "headline__i18n__es": "Sobre Santorini",
        "headline__i18n__fr": "À propos de Santorin"
      },
      {
        "_uid": "7a2d9c10-5e0b-4c11-8a31-1b0f6d2e4d04",
        "headline": "Santorini in pictures",
        "component": "destination_gallery",
        "headline__i18n__de": "Santorin in Bildern",
        "headline__i18n__es": "Santorini en imágenes",
        "headline__i18n__fr": "Santorin en images"
      },
      {
        "_uid": "7a2d9c10-5e0b-4c11-8a31-1b0f6d2e4d05",
        "text": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Fira is the hub for local transport. Most visitors combine buses with a rental vehicle.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "KTEL buses run from Fira to Oia, Perissa, Kamari and Akrotiri.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "ATVs and rental cars cover the beaches and wineries.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "A cable car or the steps lead from Fira down to the old port.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "headline": "Getting around",
        "component": "text_block",
        "text__i18n__de": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Fira ist der Knotenpunkt des lokalen Verkehrs. Die meisten Besucher kombinieren Busse mit einem Mietfahrzeug.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "KTEL-Busse fahren von Fira nach Oia, Perissa, Kamari und Akrotiri.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Quads und Mietwagen erreichen die Strände und Weingüter.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Eine Seilbahn oder die Treppen führen von Fira hinunter zum alten Hafen.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "text__i18n__es": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Fira es el centro del transporte local. La mayoría de los visitantes combinan los autobuses con un vehículo de alquiler.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Los autobuses KTEL circulan desde Fira hasta Oia, Perissa, Kamari y Akrotiri.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Los quads y los coches de alquiler llegan a las playas y las bodegas.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Un teleférico o las escaleras bajan desde Fira hasta el puerto viejo.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "text__i18n__fr": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Fira est le pivot des transports locaux. La plupart des visiteurs combinent les bus avec un véhicule de location.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bullet_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Les bus KTEL relient Fira à Oia, Perissa, Kamari et Akrotiri.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Les quads et les voitures de location desservent les plages et les domaines viticoles.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Un téléphérique ou des escaliers mènent de Fira jusqu'au vieux port.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "headline__i18n__de": "Unterwegs",
        "headline__i18n__es": "Cómo moverse",
        "headline__i18n__fr": "Se déplacer"
      },
