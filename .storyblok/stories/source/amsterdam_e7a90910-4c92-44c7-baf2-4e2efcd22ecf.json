  "content": {
    "_uid": "fa3864ec-5bcc-42c3-9976-7adc9d969c0f",
    "name": "Amsterdam",
    "usps": [
      {
        "_uid": "ade71176-2246-43a6-a71e-5a993f85060c",
        "text": "The 17th-century canal ring inside the Singelgracht became a UNESCO World Heritage site in 2010.",
        "title": "A ring of canals",
        "component": "usp_item"
      },
      {
        "_uid": "ed121bf8-526f-4ef2-9f62-c84404d070b1",
        "text": "The Rijksmuseum and the Van Gogh Museum stand on the same square, Museumplein.",
        "title": "Rembrandt and Van Gogh",
        "component": "usp_item"
      },
      {
        "_uid": "2af637af-77a9-4f65-a68f-f1eea6f59ded",
        "text": "The flat centre has separate cycle lanes on most main streets, and the garage under Centraal Station holds about 7,000 bikes.",
        "title": "Built for bikes",
        "component": "usp_item"
      },
      {
        "_uid": "0107f793-991c-4de5-b57a-e6b288b21f48",
        "text": "Wood-panelled bars in the Jordaan serve fried bitterballen with mustard next to a glass of local beer.",
        "title": "Brown cafés and bitterballen",
        "component": "usp_item"
      }
    ],
    "region": "North Holland",
    "country": "netherlands",
